# -----------------------------------------------------------------------------
# Confluence (Cloud or Data Center)
# -----------------------------------------------------------------------------
CONFLUENCE_BASE_URL=https://your-domain.atlassian.net/wiki
CONFLUENCE_SPACE_KEY=ENG
CONFLUENCE_EMAIL=you@example.com
# Cloud: an API token (https://id.atlassian.com/manage-profile/security/api-tokens)
# Data Center: a personal access token. Email is only required for Cloud.
CONFLUENCE_TOKEN=

# -----------------------------------------------------------------------------
# JIRA (Cloud or Data Center)
# -----------------------------------------------------------------------------
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_PROJECT_KEY=ENG
JIRA_EMAIL=you@example.com
JIRA_TOKEN=
# JIRA_API_TOKEN=                     # alternate name also read by the config

# -----------------------------------------------------------------------------
# GitHub
# -----------------------------------------------------------------------------
GITHUB_OWNER=your-org
GITHUB_REPO=your-repo
# GITHUB_REPOSITORY_URL=https://github.com/your-org/your-repo   # alternative to owner+repo
GITHUB_REF=
GITHUB_TOKEN=

# -----------------------------------------------------------------------------
# SharePoint (Microsoft Graph)
# -----------------------------------------------------------------------------
SHAREPOINT_SITE_URL=https://your-tenant.sharepoint.com/sites/your-site
# SHAREPOINT_SITE_ID=                 # alternative to SHAREPOINT_SITE_URL
# SHAREPOINT_DRIVE_NAME=Documents     # optional: defaults to the site's default drive

# Option A: a pre-issued Graph access token (short-lived, ~1 hour)
MICROSOFT_GRAPH_TOKEN=

# Option B: app registration client-credentials flow (the connector fetches
# its own token — use this for anything longer than an hour)
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Local filesystem
# -----------------------------------------------------------------------------
LOCAL_SOURCE_PATH=./docs

# -----------------------------------------------------------------------------
# Parser sample documents (optional)
#
# Point these at real files to exercise the parsers against actual
# PDFs/Office documents instead of the tiny synthetic fixtures the default
# test suite generates.
# -----------------------------------------------------------------------------
SAMPLE_PDF_PATH=
SAMPLE_DOCX_PATH=
SAMPLE_PPTX_PATH=
SAMPLE_XLSX_PATH=
