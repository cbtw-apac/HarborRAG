# Python - Every level
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/*.so
**/.Python
**/*.egg-info/
**/.eggs/
**/*.egg/
**/*.pyc
**/.ruff_cache/

# Virtual environments - Every level
**/venv/
**/env/
**/ENV/
**/.venv/

# IDE - Every level
**/.vscode/
**/.idea/
**/*.swp
**/*.swo

# Testing - Every level
**/.pytest_cache/
**/.tox/
**/tests/
**/htmlcov/
**/.coverage
**/coverage.xml

# Observability - Every level
**/metrics/

# Logging - Every level
**/*.log

# Local state - Every level
# Dockerfiles copy whole package directories, so anything left inside one is
# baked into the image: SQLite control databases (tenants, ACLs, encrypted
# secrets), .local/ workspaces, .harborrag/ object stores and MCP audit logs,
# and tool caches. tests/test_docker_build_context.py pins this list.
**/*.db
**/*.db-journal
**/*.sqlite
**/*.sqlite3
**/.local/
**/.harborrag/
**/.mypy_cache/
**/.hypothesis/

# Environment - Every level
# env/ (the ignored secrets folder) is already excluded by **/env/ above.
**/.env
**/.env.*
**/.env.example

# Git
**/.git/
**/.gitignore

# Docker
**/Dockerfile*
**/docker-compose*
**/.dockerignore

# Documentation
**/docs/

# Config
**/conf/
