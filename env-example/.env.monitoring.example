# Copy to env/.env.monitoring for the local monitoring stack.
# Set a strong password before passing this file directly to Docker Compose.

# Host-published monitoring UIs are loopback-only by default. Keep this value
# unless access is protected by an authenticated TLS reverse proxy and firewall.
HARBORRAG_MONITORING_BIND_ADDRESS=127.0.0.1
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Bearer token Prometheus sends to the API's /metrics on the ops port. Copy
# HARBORRAG_METRICS_SCRAPE_TOKEN from env/.env.api; a different value makes
# the harborrag-api target fail with 401 Unauthorized.
HARBORRAG_METRICS_SCRAPE_TOKEN=
