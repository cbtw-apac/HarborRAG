# Copy to env/.env.monitoring for the local monitoring stack.
# 'scripts/deployment/observability.sh bootstrap' creates it with mode 0600 and
# generates both passwords below.

# Host-published monitoring UIs are loopback-only by default. Keep this value
# unless access is protected by an authenticated TLS reverse proxy and firewall.
HARBORRAG_MONITORING_BIND_ADDRESS=127.0.0.1
PROMETHEUS_PORT=9090
GRAFANA_PORT=3030
# OTLP/HTTP port of the OpenTelemetry collector for processes run from a checkout.
# Containers on harborrag-data-network send to http://otel-collector:4318 instead.
OTEL_COLLECTOR_PORT=4318

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Bearer token Prometheus sends to the API's /metrics on the ops port. Copy
# HARBORRAG_METRICS_SCRAPE_TOKEN from env/.env.api; a different value makes
# the harborrag-api target fail with 401 Unauthorized.
HARBORRAG_METRICS_SCRAPE_TOKEN=

# Password of harborrag_observer, the read-only PostgreSQL role Grafana and
# postgres-exporter log in with. 'observability.sh db-access' sets it in PostgreSQL.
HARBORRAG_OBSERVER_PASSWORD=

# Webhook URLs Alertmanager posts alerts to: critical alerts to on-call, warnings to
# the team. Blank delivers nothing; alerts still show in Grafana and Prometheus.
HARBORRAG_ALERT_ONCALL_WEBHOOK_URL=
HARBORRAG_ALERT_TEAM_WEBHOOK_URL=

# Percentage of traces the collector keeps besides every failed trace and every
# trace slower than 2s. Production uses about 10.
HARBORRAG_TRACE_SAMPLE_PERCENT=100
