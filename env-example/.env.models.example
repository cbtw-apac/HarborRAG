# Copy to env/.env.models and replace placeholders with real provider configuration.
#
# The active config/models/models.yaml sends chat, embedding and reranking through one
# LiteLLM proxy gateway and requires all five gateway values below. References are
# expanded eagerly at load time, so a missing reranker variable fails exactly as hard
# as a missing chat one.
# Nothing auto-loads this file: pass it with `uv run --env-file env/.env.models`,
# export the variables, or let Docker Compose inject it.

# Model gateway (LiteLLM proxy). The model values are the gateway's model names, as
# listed by GET <HARBORRAG_URL>/v1/models. Changing the embedding model needs a
# re-index.
HARBORRAG_URL=https://gateway.example.com
HARBORRAG_API_KEY=REPLACE_WITH_GATEWAY_API_KEY
HARBORRAG_CHAT_MODEL=REPLACE_WITH_GATEWAY_CHAT_MODEL
HARBORRAG_EMBED_MODEL=REPLACE_WITH_GATEWAY_EMBEDDING_MODEL
HARBORRAG_RERANKER_MODEL=REPLACE_WITH_GATEWAY_RERANK_MODEL

# Provider credentials for alternative catalogs such as
# config/models/models.production.example.yaml.
OPENAI_API_KEY=REPLACE_WITH_REAL_OPENAI_API_KEY
OPENAI_API_KEY_SECONDARY=REPLACE_WITH_SECONDARY_OPENAI_API_KEY
ANTHROPIC_API_KEY=REPLACE_WITH_REAL_ANTHROPIC_API_KEY
COHERE_API_KEY=REPLACE_WITH_REAL_COHERE_API_KEY
COHERE_API_KEY_SECONDARY=REPLACE_WITH_SECONDARY_COHERE_API_KEY
AZURE_OPENAI_API_KEY=REPLACE_WITH_REAL_AZURE_OPENAI_API_KEY
AZURE_OPENAI_ENDPOINT=https://azure.example.com
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=REPLACE_WITH_AZURE_CHAT_DEPLOYMENT
AZURE_OPENAI_EMBED_DEPLOYMENT=REPLACE_WITH_AZURE_EMBED_DEPLOYMENT
AWS_REGION=us-east-1
GEMINI_API_KEY=REPLACE_WITH_REAL_GEMINI_API_KEY
OPENAI_COMPATIBLE_API_KEY=REPLACE_WITH_GATEWAY_API_KEY
OPENAI_COMPATIBLE_API_BASE=https://gateway.example.com/v1
HARBOR_GATEWAY_TENANT=example-tenant

# Live smoke tests use their own explicit variables below so they never run by
# accident merely because an application configuration key is present.
HARBOR_SMOKE_TIMEOUT_SECONDS=90

# Other provider examples, for an alternative catalog that talks to a provider or
# another proxy directly, and for the adapter live smoke suite
# (packages/harborrag-adapters/tests/models/smoke). They stay commented out because
# HARBORRAG_CHAT_MODEL and HARBORRAG_EMBED_MODEL are already set above for the
# gateway; uncommented here they would replace those values.

# Chat transport backend: direct_sdk, litellm_router, or litellm_proxy.
# HARBORRAG_CHAT_BACKEND=direct_sdk
# HARBORRAG_CHAT_PROXY_API_BASE=https://proxy.example.com
# HARBORRAG_CHAT_PROXY_API_KEY=
# HARBORRAG_CHAT_PROXY_HEADERS_JSON={}

# Chat example: OpenAI
# HARBORRAG_CHAT_PROVIDER=openai
# HARBORRAG_CHAT_MODEL=openai/REPLACE_WITH_REAL_CHAT_MODEL
# HARBORRAG_CHAT_API_KEY=REPLACE_WITH_REAL_CHAT_API_KEY
# HARBORRAG_CHAT_API_BASE=
# HARBORRAG_CHAT_API_VERSION=
# HARBORRAG_CHAT_DEPLOYMENT_NAME=
# HARBORRAG_CHAT_CUSTOM_LLM_PROVIDER=
# HARBORRAG_CHAT_ALLOW_AMBIENT_CREDENTIALS=false
# HARBORRAG_CHAT_HEADERS_JSON={"X-Custom-Header":"value"}
# HARBORRAG_CHAT_EXTRA_LITELLM_PARAMS_JSON={}

# Embedding example: OpenAI
# HARBORRAG_EMBED_PROVIDER=openai
# HARBORRAG_EMBED_MODEL=openai/REPLACE_WITH_REAL_EMBEDDING_MODEL
# HARBORRAG_EMBED_API_KEY=REPLACE_WITH_REAL_EMBEDDING_API_KEY
# HARBORRAG_EMBED_SPACE=smoke-embedding-space-v1
# HARBORRAG_EMBED_EXPECTED_DIMENSIONS=1536
# HARBORRAG_EMBED_API_BASE=
# HARBORRAG_EMBED_API_VERSION=
# HARBORRAG_EMBED_DEPLOYMENT_NAME=
# HARBORRAG_EMBED_CUSTOM_LLM_PROVIDER=
# HARBORRAG_EMBED_ALLOW_AMBIENT_CREDENTIALS=false
# HARBORRAG_EMBED_HEADERS_JSON={}
# HARBORRAG_EMBED_EXTRA_LITELLM_PARAMS_JSON={}

# Conversation-memory model (optional). Only needed when a `memory` logical model
# is added to config/models/models.yaml (see docs/users/configuration/model-config.md,
# "Optional memory model"); otherwise the memory layer reuses the default chat model.
# Through the gateway it is the gateway's model name:
# HARBORRAG_MEMORY_MODEL=REPLACE_WITH_GATEWAY_SMALL_CHAT_MODEL
# A catalog that calls a provider directly also sets:
# HARBORRAG_MEMORY_PROVIDER=openai
# HARBORRAG_MEMORY_API_KEY=REPLACE_WITH_REAL_CHAT_API_KEY

# Optional sanitized embedding telemetry. Enable it separately with
# HARBORRAG_LANGFUSE_ENABLED=true in env/.env.temporal.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Graph policy, LLM budgets, and graph-worker behavior have one authority:
# config/graph/build.yaml. This optional variable only selects another file.
# HARBORRAG_GRAPH_BUILD_CONFIG_PATH=config/graph/build.yaml

# Rerank smoke test example: Cohere
HARBOR_SMOKE_RERANK_PROVIDER=cohere
HARBOR_SMOKE_RERANK_MODEL=cohere/REPLACE_WITH_REAL_RERANK_MODEL
HARBOR_SMOKE_RERANK_API_KEY=REPLACE_WITH_REAL_RERANK_API_KEY
# HARBOR_SMOKE_RERANK_API_BASE=
# HARBOR_SMOKE_RERANK_API_VERSION=
# HARBOR_SMOKE_RERANK_CUSTOM_LLM_PROVIDER=
# HARBOR_SMOKE_RERANK_ALLOW_AMBIENT_CREDENTIALS=false
# HARBOR_SMOKE_RERANK_HEADERS_JSON={}
# HARBOR_SMOKE_RERANK_EXTRA_LITELLM_PARAMS_JSON={}

# Optional cloud/ambient fields for Bedrock or Vertex configurations.
# HARBORRAG_CHAT_AWS_REGION_NAME=us-east-1
# HARBORRAG_CHAT_AWS_ACCESS_KEY_ID=
# HARBORRAG_CHAT_AWS_SECRET_ACCESS_KEY=
# HARBORRAG_CHAT_AWS_SESSION_TOKEN=
# HARBORRAG_EMBED_VERTEX_PROJECT=
# HARBORRAG_EMBED_VERTEX_LOCATION=
# HARBOR_SMOKE_RERANK_VERTEX_PROJECT=
# HARBOR_SMOKE_RERANK_VERTEX_LOCATION=
