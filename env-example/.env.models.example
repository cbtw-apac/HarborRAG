# Copy to .env and replace placeholders with real provider configuration.

# Credentials referenced by config/models.example.yaml and config/models.advance.example.yaml.
OPENAI_API_KEY=REPLACE_WITH_REAL_OPENAI_API_KEY
OPENAI_API_KEY_SECONDARY=REPLACE_WITH_SECONDARY_OPENAI_API_KEY
ANTHROPIC_API_KEY=REPLACE_WITH_REAL_ANTHROPIC_API_KEY
COHERE_API_KEY=REPLACE_WITH_REAL_COHERE_API_KEY
COHERE_API_KEY_SECONDARY=REPLACE_WITH_SECONDARY_COHERE_API_KEY
AZURE_OPENAI_API_KEY=REPLACE_WITH_REAL_AZURE_OPENAI_API_KEY
AZURE_OPENAI_API_BASE=https://azure.example.com
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=REPLACE_WITH_AZURE_CHAT_DEPLOYMENT
AZURE_OPENAI_EMBED_DEPLOYMENT=REPLACE_WITH_AZURE_EMBED_DEPLOYMENT
AWS_REGION=us-east-1
GEMINI_API_KEY=REPLACE_WITH_REAL_GEMINI_API_KEY
OPENAI_COMPATIBLE_API_KEY=REPLACE_WITH_GATEWAY_API_KEY
OPENAI_COMPATIBLE_API_BASE=https://gateway.example.com/v1
HARBOR_GATEWAY_TENANT=example-tenant

# Live smoke tests use their own explicit variables below so they never run by
# accident merely because an application configuration key is present.
HARBOR_SMOKE_TIMEOUT_SECONDS=90

# Chat transport backend: direct_sdk, litellm_router, or litellm_proxy.
HARBOR_CHAT_BACKEND=direct_sdk
# HARBOR_CHAT_PROXY_API_BASE=https://proxy.example.com
# HARBOR_CHAT_PROXY_API_KEY=
# HARBOR_CHAT_PROXY_HEADERS_JSON={}

# Chat example: OpenAI
HARBOR_CHAT_PROVIDER=openai
HARBOR_CHAT_MODEL=openai/REPLACE_WITH_REAL_CHAT_MODEL
HARBOR_CHAT_API_KEY=REPLACE_WITH_REAL_CHAT_API_KEY
# HARBOR_CHAT_API_BASE=
# HARBOR_CHAT_API_VERSION=
# HARBOR_CHAT_DEPLOYMENT_NAME=
# HARBOR_CHAT_CUSTOM_LLM_PROVIDER=
# HARBOR_CHAT_ALLOW_AMBIENT_CREDENTIALS=false
# HARBOR_CHAT_HEADERS_JSON={"X-Custom-Header":"value"}
# HARBOR_CHAT_EXTRA_LITELLM_PARAMS_JSON={}

# Embedding example: OpenAI
HARBOR_EMBED_PROVIDER=openai
HARBOR_EMBED_MODEL=openai/REPLACE_WITH_REAL_EMBEDDING_MODEL
HARBOR_EMBED_API_KEY=REPLACE_WITH_REAL_EMBEDDING_API_KEY
HARBOR_EMBED_SPACE=smoke-embedding-space-v1
# HARBOR_EMBED_EXPECTED_DIMENSIONS=1536
# HARBOR_EMBED_API_BASE=
# HARBOR_EMBED_API_VERSION=
# HARBOR_EMBED_DEPLOYMENT_NAME=
# HARBOR_EMBED_CUSTOM_LLM_PROVIDER=
# HARBOR_EMBED_ALLOW_AMBIENT_CREDENTIALS=false
# HARBOR_EMBED_HEADERS_JSON={}
# HARBOR_EMBED_EXTRA_LITELLM_PARAMS_JSON={}

# Optional sanitized embedding telemetry. Enable it separately with
# HARBORRAG_LANGFUSE_ENABLED=true in env/.env.temporal.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Reranking example: Cohere
HARBOR_SMOKE_RERANK_PROVIDER=cohere
HARBOR_SMOKE_RERANK_MODEL=cohere/REPLACE_WITH_REAL_RERANK_MODEL
HARBOR_SMOKE_RERANK_API_KEY=REPLACE_WITH_REAL_RERANK_API_KEY
# HARBOR_SMOKE_RERANK_API_BASE=
# HARBOR_SMOKE_RERANK_API_VERSION=
# HARBOR_SMOKE_RERANK_CUSTOM_LLM_PROVIDER=
# HARBOR_SMOKE_RERANK_ALLOW_AMBIENT_CREDENTIALS=false
# HARBOR_SMOKE_RERANK_HEADERS_JSON={}
# HARBOR_SMOKE_RERANK_EXTRA_LITELLM_PARAMS_JSON={}

# Optional cloud/ambient fields for Bedrock or Vertex configurations.
# HARBOR_CHAT_AWS_REGION_NAME=us-east-1
# HARBOR_CHAT_AWS_ACCESS_KEY_ID=
# HARBOR_CHAT_AWS_SECRET_ACCESS_KEY=
# HARBOR_CHAT_AWS_SESSION_TOKEN=
# HARBOR_EMBED_VERTEX_PROJECT=
# HARBOR_EMBED_VERTEX_LOCATION=
# HARBOR_SMOKE_RERANK_VERTEX_PROJECT=
# HARBOR_SMOKE_RERANK_VERTEX_LOCATION=
