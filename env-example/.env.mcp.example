# Copy to env/.env.mcp for the local MCP server. The bootstrap command fills
# this value with a cryptographically random token and protects the file with
# mode 0600. Never commit the populated env/.env.mcp file.
HARBORRAG_MCP_BEARER_TOKEN=

# Authentication for the HTTP transport. 'local' (default) uses the single
# bearer token above with the owner role; it also unlocks the status UI's
# configuration editor. 'api_key' accepts only hashed, tenant-bound reader
# keys with a TTL, issued by 'harborrag auth keys create' and stored in the
# control database (HARBORRAG_MCP_KEY_STORE=postgres, the default). Keys
# carry the environment they were issued for, so HARBORRAG_ENV must match.
# HARBORRAG_MCP_AUTH_MODE=api_key
# HARBORRAG_MCP_KEY_STORE=postgres

# Optional MCP runtime overrides.
HARBORRAG_MCP_CONFIG_PATH=config/mcp.yaml
HARBORRAG_MCP_HOST=127.0.0.1
HARBORRAG_MCP_PORT=8010
HARBORRAG_MCP_PATH=/mcp

# For a deliberately shared single-tenant corpus, explicitly bind this local
# token to that tenant and enable published-corpus access. Keep source_acl (the
# default) if source/document permissions must be enforced.
# HARBORRAG_MCP_READER_TENANT_ID=DEFAULT
# HARBORRAG_CORPUS_ACCESS_MODE=tenant_shared
# HARBORRAG_CORPUS_SHARED_TENANT_ID=DEFAULT

# Serve find_entities and facet.* filters from the source-entity points the
# summary worker publishes. Match HARBORRAG_SUMMARY_ENTITY_INDEX_ENABLED in
# env/.env.temporal: on here alone, find_entities searches an empty index.
# HARBORRAG_SUMMARY_ENTITY_INDEX_ENABLED=true

# Owner-only JSONL audit log for MCP tool calls. Records the principal, an arguments
# digest, and the outcome -- never the bearer token or raw arguments.
# HARBORRAG_MCP_AUDIT_PATH=.harborrag/mcp-audit.jsonl

# HTTP port of the separate Explorer MCP UI server (harborrag-mcp-ui). It shares
# the host, path, token and configuration above.
# HARBORRAG_MCP_UI_PORT=8011
