# The enabled pdf-liteparse profile in config/parsers.yaml requires no
# credentials by default; it calls the ocr_server_url configured there for OCR.
# Uncomment only the variables required by the alternative parser block that
# you enable in config/parsers.yaml.

# LiteParse encrypted-PDF support.
# PDF_DOCUMENT_PASSWORD=

# OCR server used by the enabled pdf-liteparse and image-liteparse profiles for
# scanned pages and raster attachments. Unset, config/parsers.yaml defaults to
# http://ppocr-server:8888/ocr, the Docker DNS alias the server publishes on the
# external harborrag-data-network - correct for the containerized worker. Set it
# when the server is somewhere else, for example when running on the host, where
# that alias does not resolve and every scanned page fails with
# "OCR failed: ... error sending request". Leave it commented out rather than
# blank: an empty value is used as configured, it does not fall back.
# HARBORRAG_OCR_SERVER_URL=http://localhost:8888/ocr

# MinerU remote VLM endpoint. The endpoint must serve a MinerU-compatible model
# through an OpenAI-compatible API; a generic OpenAI model is not assumed to be
# compatible with MinerU's document extraction protocol.
# OPENAI_API_KEY=
# OPENAI_VLM_MODEL=opendatalab/MinerU2.5-2509-1.2B
# MINERU_API_MAX_CONCURRENT_REQUESTS=4

# Optional model/cache controls consumed by parser dependencies.
# HF_HOME=./.cache/huggingface
# PADDLE_PDX_MODEL_SOURCE=HuggingFace

# Optional Tesseract language-data directory for OCR integrations.
# Windows example: C:/Program Files/Tesseract-OCR/tessdata
# TESSDATA_PREFIX=
