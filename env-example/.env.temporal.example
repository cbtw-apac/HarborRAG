# Copy to env/.env.temporal. These defaults are for local development only.
# Container image tags are pinned in deploy/compose/docker-compose.temporal.yml.

TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8080
TEMPORAL_POSTGRES_USER=temporal
TEMPORAL_POSTGRES_PASSWORD=change-me

HARBORRAG_TEMPORAL_NAMESPACE=harborrag
HARBORRAG_TEMPORAL_IDENTITY=harborrag-runtime
HARBORRAG_TEMPORAL_WORKER_GROUPS=discovery,processing,indexing,maintenance
HARBORRAG_TEMPORAL_WORKER_REPLICAS=2
TEMPORAL_NAMESPACE_RETENTION=7d

# The worker is off by default. TEMPORAL_START_WORKER is an on/off switch;
# HARBORRAG_TEMPORAL_WORKER_REPLICAS above controls the container count. It
# uses HarborRAG's built-in production dependency graph when enabled. Set a
# custom provider only to override it.
TEMPORAL_START_WORKER=0
# HARBORRAG_TEMPORAL_DEPENDENCY_PROVIDER=my_app.runtime:build_dependencies

# Worker configuration and source mounts. Credentials referenced by these
# tracked YAML files belong in the ignored env/ directory.
HARBORRAG_CONNECTOR_CONFIG_PATH=config/connectors.yaml
HARBORRAG_PARSER_CONFIG_PATH=config/parsers.yaml
HARBORRAG_MODEL_CONFIG_PATH=config/models.yaml
HARBORRAG_LOCAL_SOURCE_MOUNT=../../docs

# The worker joins harborrag-data-network and resolves services by Compose name.
HARBORRAG_QDRANT_URL=http://qdrant:6333
HARBORRAG_FALKORDB_HOST=falkordb
HARBORRAG_FALKORDB_PORT=6379
HARBORRAG_REDIS_URL=redis://redis:6379/0
