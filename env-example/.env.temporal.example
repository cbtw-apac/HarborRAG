# Copy to env/.env.temporal. These defaults are for local development only.
# Container image tags are pinned in deploy/compose/docker-compose.temporal.yml.
# Published ports default to loopback. Set 0.0.0.0 only when remote access is
# intentional and protected by a firewall.
HARBORRAG_TEMPORAL_BIND_ADDRESS=127.0.0.1

TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8080
# Temporal reuses the PostgreSQL service from docker-compose.database.yml.
# scripts/deployment/dev.sh reads POSTGRES_USER and POSTGRES_PASSWORD directly
# from DATABASE_ENV_FILE (env/.env.database by default).
TEMPORAL_POSTGRES_HOST=postgres

HARBORRAG_TEMPORAL_API_KEY=
HARBORRAG_TEMPORAL_NAMESPACE=harborrag
HARBORRAG_TEMPORAL_WORKER_REPLICAS=2
# Control-database pool for the worker; must satisfy 6 * worker.max_concurrent_activities
# (config/temporal.yaml) <= pool + overflow, or the worker refuses to start.
# Must cover config/temporal.yaml's 6 queues * worker.max_concurrent_activities
# (4 * 6 = 24); the runtime refuses to start otherwise.
# HARBORRAG_CONTROL_DB_POOL_SIZE=40
# HARBORRAG_CONTROL_DB_MAX_OVERFLOW=32
# Client identity, worker capacity, TLS, and timeouts are configured in
# config/temporal.yaml. For Temporal Cloud, enable TLS in that file, override
# the Compose target here, and store the real API key only in env/.env.temporal.
# HARBORRAG_TEMPORAL_TARGET=namespace.account.tmprl.cloud:7233
# HARBORRAG_TEMPORAL_ALLOW_INSECURE_REMOTE=false
# How long closed workflow histories stay queryable. Each document is its own
# ~75-event workflow, so a large source leaves tens of millions of events in
# the shared PostgreSQL; 3d still covers debugging a run. Applied to the
# existing namespace on the next 'dev.sh temporal'.
TEMPORAL_NAMESPACE_RETENTION=3d
# INFO reports submissions, discovery, document outcomes, and failures. DEBUG
# additionally reports every Temporal activity boundary and duration.
HARBORRAG_LOG_LEVEL=INFO
# Container log rotation (json-file, per container). Every compose file reads
# these, so set them in each project's env file to override.
# HARBORRAG_LOG_MAX_SIZE=50m
# HARBORRAG_LOG_MAX_FILE=3

# Temporal server memory cap and Go heap target. Keep GOMEMLIMIT ~90% of the
# cap so garbage collection runs before the container hits it.
# HARBORRAG_TEMPORAL_SERVER_MEMORY=1536m
# HARBORRAG_TEMPORAL_SERVER_GOMEMLIMIT=1350MiB

# The worker exposes Prometheus metrics on its internal port 9464. Langfuse is
# opt-in and is used only for sanitized model-backed embedding operations;
# keep Langfuse credentials in the ignored env/.env.models file.
HARBORRAG_LANGFUSE_ENABLED=false

# The worker joins harborrag-data-network and resolves services by Compose name.
HARBORRAG_QDRANT_URL=http://qdrant:6333
HARBORRAG_FALKORDB_HOST=falkordb
HARBORRAG_FALKORDB_PORT=6379
# Relation repair fans out document work but must remain below the shared
# FalkorDB client pool. The adapter also queues every operation at the pool
# boundary, so temporary bursts wait instead of failing with connection errors.
HARBORRAG_FALKORDB_MAX_CONNECTIONS=32
HARBORRAG_GRAPH_RELATION_REPAIR_CONCURRENCY=8
HARBORRAG_REDIS_URL=redis://redis:6379/0

# Which tenant the worker ingests into, and the basis summarization runs on.
# Summarization resolves an ACL snapshot per document and per scope, and blocks
# the scope with SUMMARY_PERMISSION_SNAPSHOT_MISSING when one is missing; only
# the operator command `topology security permissions-import` writes those rows,
# one document at a time. tenant_shared puts the worker on an operator-approved
# processing basis instead, granted to this one tenant. The three values are
# validated together, and the tenant must match the one in
# config/topology/graph_build.yaml (and env/.env.mcp for the reader).
HARBORRAG_INGESTION_TENANT_ID=DEFAULT
HARBORRAG_CORPUS_ACCESS_MODE=tenant_shared
HARBORRAG_CORPUS_SHARED_TENANT_ID=DEFAULT
HARBORRAG_SUMMARY_PROCESSING_ALLOWED=false

# Publish each accepted source-entity card as a searchable vector point, so
# find_entities and facet.* filters have something to hit. Costs one embedding
# per entity per regeneration; set the same value in env/.env.mcp.
HARBORRAG_SUMMARY_ENTITY_INDEX_ENABLED=false
