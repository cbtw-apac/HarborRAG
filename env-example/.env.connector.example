# Copy to env/.env.connector.
#
# config/sources/connectors.yaml enables four connections: harborrag-workspace (local files,
# no credentials needed), confluence-main, jira-main and sharepoint-main. A remote one is
# imported with status error until its values below are uncommented and filled in.
# LOCAL_SOURCE_PATH is the host folder dev.sh mounts for the harborrag-workspace
# connection; unset means ./docs. A relative path is resolved from the repository root.
# LOCAL_SOURCE_PATH=./docs

# Connectors reach public addresses only. To reach a private one, such as Jira or
# Confluence Data Center inside your network, list its host name or network here
# (comma-separated, e.g. jira.acme.internal,10.20.0.0/16), and the same list in
# env/.env.api so connection tests can reach it too.
# HARBORRAG_CONNECTOR_ALLOWED_HOSTS=

# Uncomment the matching group when enabling a remote connector example.

# Confluence (Cloud or Data Center)
# CONFLUENCE_BASE_URL=https://your-domain.atlassian.net/wiki
# CONFLUENCE_SPACE_KEY=ENG
# CONFLUENCE_EMAIL=you@example.com
# CONFLUENCE_TOKEN=

# JIRA (Cloud or Data Center)
# JIRA_BASE_URL=https://your-domain.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_TOKEN=
# Project keys jira-main ingests, comma-separated; config/sources/connectors.yaml maps
# its project_keys to this variable.
# JIRA_PROJECT_KEY=ENG

# Attachment parsing (the PDF and image engines) is configured in
# config/ingestion/parsers.yaml, not through environment variables.

# GitHub
# GITHUB_REPOSITORY_URL=https://github.com/your-org/your-repo
# GITHUB_OWNER=your-org
# GITHUB_REPO=your-repo
# GITHUB_REF=main
# GITHUB_TOKEN=

# SharePoint (Microsoft Graph)
# SHAREPOINT_SITE_URL=https://your-tenant.sharepoint.com/sites/your-site
# SHAREPOINT_SITE_ID=
# SHAREPOINT_DRIVE_NAME=Documents
# MICROSOFT_GRAPH_TOKEN=
# MICROSOFT_TENANT_ID=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
