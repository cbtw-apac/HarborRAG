# Required by the enabled harborrag-workspace connection in config/connectors.yaml.
# Relative paths are resolved from the HarborRAG process working directory.
# LOCAL_SOURCE_PATH=./docs

# Uncomment the matching group when enabling a remote connector example.

# Confluence (Cloud or Data Center)
# CONFLUENCE_BASE_URL=https://your-domain.atlassian.net/wiki
# CONFLUENCE_SPACE_KEY=ENG
# CONFLUENCE_EMAIL=you@example.com
# CONFLUENCE_TOKEN=

# JIRA (Cloud or Data Center)
# JIRA_BASE_URL=https://your-domain.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_TOKEN=
# JIRA_API_TOKEN=
# Convenience override for the smoke checks only: applied when
# config/connectors.yaml leaves jira.settings.project_keys empty. To scope a
# real deployment, set project_keys directly in config/connectors.yaml.
# JIRA_PROJECT_KEY=ENG

# Confluence/JIRA attachment parsing (Docling for PDF, RapidOCR for images) is
# configured in config/parsers.yaml, not through environment variables.

# GitHub
# GITHUB_REPOSITORY_URL=https://github.com/your-org/your-repo
# GITHUB_OWNER=your-org
# GITHUB_REPO=your-repo
# GITHUB_REF=main
# GITHUB_TOKEN=

# SharePoint (Microsoft Graph)
# SHAREPOINT_SITE_URL=https://your-tenant.sharepoint.com/sites/your-site
# SHAREPOINT_SITE_ID=
# SHAREPOINT_DRIVE_NAME=Documents
# MICROSOFT_GRAPH_TOKEN=
# MICROSOFT_TENANT_ID=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
