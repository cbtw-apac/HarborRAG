# Copy this file to env/.env.database and adjust values for your environment.
#
# Do not commit production credentials.
# Container image tags are pinned in deploy/compose/docker-compose.database.yml.

# ---------------------------------------------------------------------------
# Qdrant
# ---------------------------------------------------------------------------
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# ---------------------------------------------------------------------------
# FalkorDB
# ---------------------------------------------------------------------------
FALKORDB_PORT=6379
FALKORDB_BROWSER_PORT=3000

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_PORT=6380

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=harborrag

# ---------------------------------------------------------------------------
# Deployment script
# ---------------------------------------------------------------------------
# Pull images before starting the stack: 1=true, 0=false.
DATABASE_PULL=0

# Maximum number of seconds to wait for database containers to become ready.
DATABASE_STARTUP_TIMEOUT=120

# Optional overrides. Leave commented to use repository defaults.
# DATABASE_COMPOSE_FILE=/absolute/path/to/docker-compose.database.yml
# DATABASE_ENV_FILE=/absolute/path/to/env/.env.database
