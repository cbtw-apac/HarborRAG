# Copy this file to env/.env.database and adjust values for your environment.
#
# Do not commit production credentials.
# Container image tags are pinned in deploy/compose/docker-compose.database.yml.
# Published ports default to loopback. Set 0.0.0.0 only when remote access is
# intentional and protected by a firewall and backend authentication.
HARBORRAG_DATA_BIND_ADDRESS=127.0.0.1

# ---------------------------------------------------------------------------
# Qdrant
# ---------------------------------------------------------------------------
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# ---------------------------------------------------------------------------
# FalkorDB
# ---------------------------------------------------------------------------
FALKORDB_PORT=6379
FALKORDB_BROWSER_PORT=3000
# Graph evaluation suite (tests/graph_eval) tenant and FalkorDB graph.
# Defaults match the committed baseline; override only for isolated eval runs.
# HARBORRAG_EVAL_TENANT_ID=graph-eval
# HARBORRAG_EVAL_GRAPH_NAME=harborrag-graph-eval

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_PORT=6380

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=harborrag

# Host-side CLI only: a repo-checkout `harborrag` reads this line when the variable is
# not exported, so `ingest run`/`ingest start` record runs in the stack's Postgres
# instead of a local sqlite file. ${...} resolves from the shell, then this file, and is
# substituted verbatim: URL-encode a password holding @ : / # % or ?. Containers ignore
# it (compose sets their own URL with the in-cluster `postgres` host). Every checkout
# CLI command then migrates this database, so rebuild the images first. The CLI also
# takes HARBORRAG_SECRETS_ENCRYPTION_KEY below from this file when it uses the line.
# HARBORRAG_CONTROL_DB_URL="postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_PORT:-5432}/${POSTGRES_DB}"

# The folder local connections must stay inside, as the API and workers see it. Compose
# sets this value in the containers; the host CLI reads it from here, so a stored
# source_path such as /data/sources is accepted on the host too.
HARBORRAG_LOCAL_SOURCE_ROOT=/data/sources

# ---------------------------------------------------------------------------
# MinIO
# ---------------------------------------------------------------------------
# S3-compatible API:
#   Host:              http://127.0.0.1:9000
#   Docker network:    http://minio:9000
#
# Object-browser console:
#   http://127.0.0.1:9001
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=harborrag
MINIO_ROOT_PASSWORD=change-me-minio

# ---------------------------------------------------------------------------
# Control-plane secrets
# ---------------------------------------------------------------------------
# Encrypts stored secrets (e.g. connector credentials) in the PostgreSQL
# control database. Required whenever HARBORRAG_CONTROL_DB_URL is not
# SQLite -- api and temporal-worker both read this value, so it must stay
# identical across both, and must not change once secrets have been stored
# under it (rotating requires re-encrypting or re-entering the secrets).
#
# This ships empty: scripts/deployment/dev.sh generates it on bootstrap or first start
# and writes it here. Back this file up; stored connection secrets cannot be read
# without the key. Outside dev.sh, set it yourself (openssl rand -hex 32), or point
# HARBORRAG_SECRETS_ENCRYPTION_KEY_FILE at a file holding it, such as a Docker or
# Kubernetes secret.
HARBORRAG_SECRETS_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Deployment script
# ---------------------------------------------------------------------------
# Pull images before starting the stack: 1=true, 0=false.
DATABASE_PULL=0

# Maximum number of seconds to wait for database containers to become ready.
DATABASE_STARTUP_TIMEOUT=120

# Optional overrides. Leave commented to use repository defaults.
# DATABASE_COMPOSE_FILE=/absolute/path/to/docker-compose.database.yml
# DATABASE_ENV_FILE=/absolute/path/to/env/.env.database
