# Copy this file to env/.env.database and adjust values for your environment.
#
# Do not commit production credentials.
# Container image tags are pinned in deploy/compose/docker-compose.database.yml.
# Published ports default to loopback. Set 0.0.0.0 only when remote access is
# intentional and protected by a firewall and backend authentication.
HARBORRAG_DATA_BIND_ADDRESS=127.0.0.1

# ---------------------------------------------------------------------------
# Qdrant
# ---------------------------------------------------------------------------
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
# Every Qdrant HTTP and gRPC request must carry this key. Generated by
# `scripts/deployment/dev.sh bootstrap` when empty; the launchers refuse to
# start while it is empty. The API, worker, and MCP receive it as
# HARBORRAG_QDRANT_API_KEY; export that name for host-side tools.
QDRANT_API_KEY=

# ---------------------------------------------------------------------------
# FalkorDB
# ---------------------------------------------------------------------------
FALKORDB_PORT=6379
FALKORDB_BROWSER_PORT=3000
# Redis-protocol password (requirepass); also the FalkorDB browser login.
# Generated by bootstrap when empty. The API, worker, and MCP receive it as
# HARBORRAG_FALKORDB_PASSWORD; the graph evaluation and repository smoke checks
# read FALKORDB_PASSWORD from this file directly.
FALKORDB_PASSWORD=
# Graph evaluation suite (tests/graph_eval) tenant and FalkorDB graph.
# Defaults match the committed baseline; override only for isolated eval runs.
# HARBORRAG_EVAL_TENANT_ID=graph-eval
# HARBORRAG_EVAL_GRAPH_NAME=harborrag-graph-eval
# The graph is held in RAM (~12.6 KB per Jira document); size the cap to the corpus.
# HARBORRAG_FALKORDB_MEMORY=3g

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_PORT=6380
# requirepass for the ingestion rate-limit/cache Redis. Generated by bootstrap
# when empty. Compose builds the worker's and API's redis://:PASSWORD@redis URLs
# from it, so a hand-set value must not contain @ / : # ? % or whitespace.
REDIS_PASSWORD=
# Ingestion keeps only rate-limit buckets here. Raise both if the model-response
# cache is enabled.
# HARBORRAG_REDIS_MEMORY=256m
# HARBORRAG_REDIS_MAXMEMORY=192mb

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_PORT=5432
POSTGRES_USER=postgres
# Generated by bootstrap when empty; the launchers refuse an empty or
# placeholder value. PostgreSQL applies it only when its volume is first
# initialised: to change it later, run ALTER USER inside the container, or
# discard the volume with `scripts/deployment/dev.sh down --volumes`.
POSTGRES_PASSWORD=
POSTGRES_DB=harborrag

# ---------------------------------------------------------------------------
# MinIO
# ---------------------------------------------------------------------------
# S3-compatible API:
#   Host:              http://127.0.0.1:9000
#   Docker network:    http://minio:9000
#
# Object-browser console:
#   http://127.0.0.1:9001
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=harborrag
# Generated by bootstrap when empty; the launchers refuse an empty or
# placeholder value.
MINIO_ROOT_PASSWORD=
# Transparent compression of JSON artifacts (new objects only). Set to off to disable.
# HARBORRAG_MINIO_COMPRESSION_ENABLE=on

# ---------------------------------------------------------------------------
# Control-plane secrets
# ---------------------------------------------------------------------------
# Encrypts stored secrets (e.g. connector credentials) in the PostgreSQL
# control database. Required whenever HARBORRAG_CONTROL_DB_URL is not
# SQLite -- api and temporal-worker both read this value, so it must stay
# identical across both, and must not change once secrets have been stored
# under it (rotating requires re-encrypting or re-entering the secrets).
#
# REQUIRED: this ships empty and the supported launchers refuse to start the API or
# Temporal worker until you set it. An empty value fails the same way an unset one
# does, with:
#   HARBORRAG_SECRETS_ENCRYPTION_KEY is required for the API and worker
#
# Generate with: openssl rand -hex 32
HARBORRAG_SECRETS_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Deployment script
# ---------------------------------------------------------------------------
# Pull images before starting the stack: 1=true, 0=false.
DATABASE_PULL=0

# Maximum number of seconds to wait for database containers to become ready.
DATABASE_STARTUP_TIMEOUT=120

# Optional overrides. Leave commented to use repository defaults.
# DATABASE_COMPOSE_FILE=/absolute/path/to/docker-compose.database.yml
# DATABASE_ENV_FILE=/absolute/path/to/env/.env.database
