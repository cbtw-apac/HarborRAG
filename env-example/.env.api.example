# Copy to env/.env.api for the local API container.
# This file is injected only into the API. Embedding credentials remain in the
# dedicated ignored env/.env.models file, which the API also receives for
# synchronous vector retrieval. Connector credentials stay worker-only.

HARBORRAG_ENV=dev
HARBORRAG_AUTH_MODE=none
# Uvicorn must listen on 0.0.0.0 inside the container. The Compose port is
# published only on HARBORRAG_API_BIND_ADDRESS=127.0.0.1 below, so explicitly
# acknowledge disabled auth on this trusted local development network.
HARBORRAG_ALLOW_INSECURE_DEV=true
HARBORRAG_DOCS_ENABLED=true
HARBORRAG_CORS_ORIGINS=[]
HARBORRAG_MAX_REQUEST_BODY_BYTES=1048576
# Requests per second per principal on every /v1 route, and on chat
# completions alone. Calls over either answer 429 with Retry-After.
HARBORRAG_HTTP_RATE_DEFAULT=10
HARBORRAG_HTTP_RATE_CHAT=2
HARBORRAG_API_REQUESTS_PER_MINUTE=60
HARBORRAG_API_MAX_INFLIGHT_PER_PRINCIPAL=4
# Admission control keys on three scopes: the end user, the credential, and the
# tenant aggregate. A request must satisfy all three. The per-user pair matches
# the per-principal pair, so one human per credential behaves as before while a
# shared service credential now gives each human their own allowance.
HARBORRAG_API_REQUESTS_PER_MINUTE_PER_USER=60
HARBORRAG_API_MAX_INFLIGHT_PER_USER=4
HARBORRAG_API_REQUESTS_PER_MINUTE_PER_TENANT=600
HARBORRAG_API_MAX_INFLIGHT_PER_TENANT=40
# Optional per-tenant overrides (JSON object, tenant id -> limits). Unset
# fields inherit the values above; unknown keys or out-of-range values fail
# startup naming the tenant.
# HARBORRAG_API_TENANT_CAPACITY_OVERRIDES={"enterprise":{"user_requests_per_minute":120,"tenant_requests_per_minute":6000}}
HARBORRAG_API_REQUEST_TIMEOUT_SECONDS=120
# Compose supplies redis://redis:6379/1 and its development-only plaintext
# acknowledgement. Production must use HARBORRAG_API_CAPACITY_REDIS_URL with
# rediss://; the API refuses process-local capacity accounting in production.

# Prometheus scrapes /metrics on the ops port (9465 in the container) with
# this bearer token; scripts/deployment/dev.sh generates it when blank and
# writes the copy Prometheus reads to env/api-scrape-token.
HARBORRAG_METRICS_SCRAPE_TOKEN=

# Host publication settings consumed by Docker Compose. The ops port is
# published on loopback only.
HARBORRAG_API_BIND_ADDRESS=127.0.0.1
HARBORRAG_API_PORT=8000
HARBORRAG_API_OPS_PORT=9465
HARBORRAG_API_TEMPORAL_IDENTITY=harborrag-api
# INFO reports accepted/reused workflow submissions. DEBUG includes internal
# application-service diagnostics. Logs never include connector credentials.
HARBORRAG_LOG_LEVEL=INFO

# Tenant for non-HTTP runtime calls. Durable tasks without an explicit tenant
# are rejected rather than silently entering the DEFAULT namespace. Public
# ingestion and retrieval requests default their top-level `tenant` to DEFAULT.
HARBORRAG_INGESTION_TENANT_ID=DEFAULT

# Production HMAC mode requires a secret of at least 32 UTF-8 bytes.
# Every JWT must also carry a non-empty `tenants` list; roles do not bypass
# tenant ownership checks.
# Keep the real value only in env/.env.api or an external secret manager.
# HARBORRAG_AUTH_SECRET=
# HARBORRAG_AUTH_ISSUER=harborrag
# HARBORRAG_AUTH_AUDIENCE=harborrag-api

# Per-tenant chat models
# --------------------------------
# Off by default: every tenant answers from the process-wide `config/models/models.yaml`
# catalog, exactly as before. Turning it on lets a tenant's stored `chat`
# provider rows override that catalog for its own turns, with API keys read from
# the encrypted control-plane secret store rather than from this file. A tenant
# that configured nothing still uses the shared catalog, and a tenant whose own
# configuration is broken degrades to it with an ERROR log naming the tenant.
HARBORRAG_CHAT_TENANT_CATALOGS_ENABLED=false
# Upper bound on cached per-tenant chat clients. Each holds its own connection
# pool, so the least recently used one is disposed rather than kept.
HARBORRAG_CHAT_TENANT_CLIENT_CACHE_SIZE=32

# Conversation memory (SDK)
# --------------------------------
# Public chat completions replay only the latest three exchanges and never run
# long-term recall or extraction; these settings govern the SDK memory facade
# (`HarborRAG.memory.*`).
# Off restores a short verbatim window with no summary, recall, or extraction.
# HARBORRAG_MEMORY_ENABLED=true
# Distil durable facts from finished exchanges into long-term memory.
# HARBORRAG_MEMORY_EXTRACTION_ENABLED=true
# Let extraction store facts at PROJECT scope, where every user of the project
# recalls them. Off by default because extraction writes from model output that
# can restate retrieved, untrusted content; a project write is kept to its
# session.
# HARBORRAG_MEMORY_EXTRACTION_PROJECT_SCOPE=false
# Retention per scope in days, applied as an expiry when a memory is written;
# 0 means no automatic expiry. Expired memories are no longer returned, but
# there is no background sweeper: the rows stay stored until erased.
# HARBORRAG_MEMORY_RETENTION_DAYS_SESSION=90
# HARBORRAG_MEMORY_RETENTION_DAYS_USER=365
# HARBORRAG_MEMORY_RETENTION_DAYS_PROJECT=0

# Private hosts or networks connection tests may reach, such as a Jira Data Center
# host; keep in step with env/.env.connector. Public addresses need no entry.
# HARBORRAG_CONNECTOR_ALLOWED_HOSTS=

# Base URLs the API puts in the links of an ingestion run. The Temporal UI of
# the development compose stack listens on port 8080; leave Grafana blank to
# send no link.
HARBORRAG_TEMPORAL_UI_URL=http://localhost:8080
HARBORRAG_GRAFANA_URL=
