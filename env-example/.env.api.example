# Copy to env/.env.api for the local API container.
# This file is injected only into the API. Embedding credentials remain in the
# dedicated ignored env/.env.models file, which the API also receives for
# synchronous vector retrieval. Connector credentials stay worker-only.

HARBORRAG_ENV=dev
HARBORRAG_AUTH_MODE=none
# Uvicorn must listen on 0.0.0.0 inside the container. The Compose port is
# published only on HARBORRAG_API_BIND_ADDRESS=127.0.0.1 below, so explicitly
# acknowledge disabled auth on this trusted local development network.
HARBORRAG_ALLOW_INSECURE_DEV=true
HARBORRAG_DOCS_ENABLED=true
HARBORRAG_CORS_ORIGINS=[]
HARBORRAG_MAX_REQUEST_BODY_BYTES=1048576
HARBORRAG_API_REQUESTS_PER_MINUTE=60
HARBORRAG_API_MAX_INFLIGHT_PER_PRINCIPAL=4
HARBORRAG_API_REQUEST_TIMEOUT_SECONDS=120
# Compose supplies redis://redis:6379/1 and its development-only plaintext
# acknowledgement. Production must use HARBORRAG_API_CAPACITY_REDIS_URL with
# rediss://; the API refuses process-local capacity accounting in production.

# Host publication settings consumed by Docker Compose.
HARBORRAG_API_BIND_ADDRESS=127.0.0.1
HARBORRAG_API_PORT=8000
HARBORRAG_API_TEMPORAL_IDENTITY=harborrag-api
# INFO reports accepted/reused workflow submissions. DEBUG includes internal
# application-service diagnostics. Logs never include connector credentials.
HARBORRAG_LOG_LEVEL=INFO

# Tenant for non-HTTP runtime calls. Durable tasks without an explicit tenant
# are rejected rather than silently entering the DEFAULT namespace. Public
# ingestion and retrieval requests default their top-level `tenant` to DEFAULT.
HARBORRAG_INGESTION_TENANT_ID=DEFAULT

# Administrative projection API
# --------------------------------
# `auth_mode=none` grants the implicit local owner access to admin routes.
# Production JWTs must carry role=admin or role=owner; there is intentionally
# no admin username/password environment variable.
#
#   GET    /v1/admin/projections/DEFAULT
#   DELETE /v1/admin/projections/DEFAULT
#          X-Confirm-Tenant: DEFAULT
#
# Add `?stores=vector` or `?stores=graph` to delete only one projection store.
# Canonical PostgreSQL data is retained. Use deletion only with a planned
# reindex; incremental ingestion will not restore unchanged active versions.

# Production HMAC mode requires a secret of at least 32 UTF-8 bytes.
# Every JWT must also carry a non-empty `tenants` list; roles do not bypass
# tenant ownership checks.
# Keep the real value only in env/.env.api or an external secret manager.
# HARBORRAG_AUTH_SECRET=
# HARBORRAG_AUTH_ISSUER=harborrag
# HARBORRAG_AUTH_AUDIENCE=harborrag-api
