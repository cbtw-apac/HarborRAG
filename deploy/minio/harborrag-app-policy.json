{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "HarborRAGBuckets",
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:ListBucket"],
      "Resource": ["arn:aws:s3:::harborrag-raw", "arn:aws:s3:::harborrag-artifacts"]
    },
    {
      "Sid": "HarborRAGObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion", "s3:PutObject", "s3:DeleteObject"],
      "Resource": ["arn:aws:s3:::harborrag-raw/*", "arn:aws:s3:::harborrag-artifacts/*"]
    },
    {
      "Sid": "HarborRAGHealthPing",
      "Effect": "Allow",
      "Action": ["s3:ListAllMyBuckets"],
      "Resource": ["arn:aws:s3:::*"]
    }
  ]
}
