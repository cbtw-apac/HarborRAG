      }
    },
    {
      "type": "bargauge",
      "title": "Spend vs budget",
      "description": "Model cost of all services in the last 24 hours as a share of the daily budget (harborrag:threshold:llm_daily_budget_usd), the LLM spend alert level. Dollars by service are on Chat and LLM. Cost is what the LiteLLM proxy reports from its price list: an estimate, not the invoice. Self-hosted models report 0. There is no tenant label, so cost cannot be split per tenant.",
      "datasource": {
        "type": "prometheus",
        "uid": "harborrag-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "harborrag-prometheus"
          },
          "expr": "(sum(increase(harborrag_model_cost_usd_total[24h])) or vector(0)) / scalar(harborrag:threshold:llm_daily_budget_usd)",
          "refId": "A",
          "legendFormat": "__auto",
          "exemplar": false,
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0aac23",
                "value": null
              },
              {
                "color": "#fbb315",
                "value": 0.8
              },
              {
                "color": "#dc3c3d",
                "value": 1
              }
            ]
          },
          "links": [
            {
              "title": "Chat and LLM",
              "url": "/d/harborrag-chat-llm?${__url_time_range}&${__all_variables}"
            }
          ],
          "min": 0,
          "max": 1,
          "decimals": 1
        },
