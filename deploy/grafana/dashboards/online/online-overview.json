    {
      "type": "bargauge",
      "title": "p95 by store and operation",
      "description": "p95 of HarborRAG's own retrieval and store spans over the range, slowest first. Open Stores and host for detail.",
      "datasource": {
        "type": "prometheus",
        "uid": "harborrag-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "harborrag-prometheus"
          },
          "expr": "sort_desc(histogram_quantile(0.95, sum by (le, span_name) (rate(traces_span_metrics_duration_seconds_bucket{span_name=~\"retrieval.*|harborrag.ingestion.(qdrant_write|falkordb_write)\"}[$__range]))))",
          "refId": "A",
          "legendFormat": "{{span_name}}",
          "exemplar": false,
          "instant": true,
          "range": false
