{
  "uid": "harborrag-online-overview",
  "title": "Online overview",
  "tags": [
    "harborrag",
    "online",
    "home"
  ],
  "editable": true,
  "schemaVersion": 41,
  "version": 1,
  "graphTooltip": 1,
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "harborrag-prometheus"
        },
        "query": {
          "query": "label_values(target_info, deployment_environment)",
          "refId": "env-values"
        },
        "definition": "label_values(target_info, deployment_environment)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "tenant",
        "label": "Tenant",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "harborrag-prometheus"
        },
        "query": {
          "query": "label_values(harborrag_mcp_tool_calls_total, tenant)",
          "refId": "tenant-values"
        },
        "definition": "label_values(harborrag_mcp_tool_calls_total, tenant)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Deploys",
        "enable": true,
        "iconColor": "blue",
        "datasource": {
          "type": "prometheus",
          "uid": "harborrag-prometheus"
        },
        "expr": "count by (job, service_version) (target_info) unless count by (job, service_version) (last_over_time(target_info[1d] offset 5m))",
        "step": "1m",
        "titleFormat": "Deploy {{job}}",
        "textFormat": "version {{service_version}}"
      },
      {
        "name": "Alerts firing",
        "enable": true,
        "iconColor": "red",
        "datasource": {
          "type": "prometheus",
          "uid": "harborrag-prometheus"
        },
        "expr": "ALERTS{alertstate=\"firing\"}",
        "step": "1m",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{severity}} {{side}}"
      },
      {
        "name": "Ingestion runs",
        "enable": true,
        "iconColor": "purple",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "harborrag-postgres"
        },
        "rawQuery": "SELECT started_at AS time, completed_at AS timeend, status AS text FROM ingestion_tasks WHERE started_at IS NOT NULL AND $__timeFilter(started_at) ORDER BY started_at",
        "rawSql": "SELECT started_at AS time, completed_at AS timeend, status AS text FROM ingestion_tasks WHERE started_at IS NOT NULL AND $__timeFilter(started_at) ORDER BY started_at",
        "format": "table"
      }
    ]
  },
  "links": [
    {
      "title": "HarborRAG",
      "type": "dashboards",
      "tags": [
        "harborrag"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Runbooks",
      "type": "link",
      "icon": "doc",
      "targetBlank": true,
      "url": "https://github.com/cbtw-apac/HarborRAG/blob/main/docs/developers/deployment/observability-runbooks.md",
      "tooltip": "What each alert means and how to respond"
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Is it healthy now",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "MCP availability",
      "description": "Share of MCP tool calls without a server-side failure over 30 days (SLO 99.5%). Server-side failures are server errors plus tool failures the server caused (error_code backend_unavailable or not_configured). Red: open MCP and retrieval.",
      "datasource": {
        "type": "prometheus",
        "uid": "harborrag-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "harborrag-prometheus"
          },
          "expr": "1 - (sum(increase(harborrag_mcp_tool_calls_total{tenant=~\"$tenant\",deployment_environment=~\"$env\",status=~\"error|tool_error\",error_code=~\"|backend_unavailable|not_configured\"}[30d])) or vector(0)) / sum(increase(harborrag_mcp_tool_calls_total{tenant=~\"$tenant\",deployment_environment=~\"$env\"}[30d]))",
          "refId": "A",
          "legendFormat": "__auto",
          "exemplar": false,
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.99
              },
              {
                "color": "green",
                "value": 0.995
              }
            ]
          },
          "decimals": 2,
          "links": [
            {
              "title": "MCP and retrieval",
              "url": "/d/harborrag-mcp-retrieval?${__url_time_range}&${__all_variables}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "MCP p95 latency",
      "description": "p95 of MCP tool calls over 5 minutes. Threshold set after two weeks of baseline.",
      "datasource": {
        "type": "prometheus",
        "uid": "harborrag-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "harborrag-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(harborrag_mcp_tool_duration_seconds_bucket{tenant=~\"$tenant\",deployment_environment=~\"$env\"}[5m])))",
          "refId": "A",
          "legendFormat": "__auto",
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "links": [
            {
              "title": "MCP and retrieval",
              "url": "/d/harborrag-mcp-retrieval?${__url_time_range}&${__all_variables}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": 3,
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "MCP error rate, 5 min",
      "description": "Server-side failures per MCP tool call over 5 minutes. Red above 5%, the MCP errors alert level. Server-side failures are server errors plus tool failures the server caused (error_code backend_unavailable or not_configured).",
      "datasource": {
        "type": "prometheus",
        "uid": "harborrag-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "harborrag-prometheus"
          },
          "expr": "(sum(rate(harborrag_mcp_tool_calls_total{tenant=~\"$tenant\",deployment_environment=~\"$env\",status=~\"error|tool_error\",error_code=~\"|backend_unavailable|not_configured\"}[5m])) or vector(0)) / sum(rate(harborrag_mcp_tool_calls_total{tenant=~\"$tenant\",deployment_environment=~\"$env\"}[5m]))",
          "refId": "A",
          "legendFormat": "__auto",
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "links": [
            {
              "title": "MCP and retrieval",
              "url": "/d/harborrag-mcp-retrieval?${__url_time_range}&${__all_variables}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": 4,
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Chat first token",
      "description": "p95 over 5 minutes of the time from the start of a chat turn to its first answer text.",
      "datasource": {
        "type": "prometheus",
        "uid": "harborrag-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "harborrag-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(harborrag_chat_ttft_seconds_bucket{tenant=~\"$tenant\",deployment_environment=~\"$env\"}[5m])))",
          "refId": "A",
          "legendFormat": "__auto",
          "exemplar": false
