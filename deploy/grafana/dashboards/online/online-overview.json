    {
      "type": "timeseries",
      "title": "Traffic: MCP calls and chat turns",
      "description": "Requests per second. Deploy, ingestion-run and alert annotations show what changed.",
      "datasource": {
        "type": "prometheus",
        "uid": "harborrag-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "harborrag-prometheus"
          },
          "expr": "sum(rate(harborrag_mcp_tool_calls_total{tenant=~\"$tenant\",deployment_environment=~\"$env\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "MCP calls",
          "exemplar": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "harborrag-prometheus"
          },
          "expr": "sum(rate(harborrag_chat_turns_total{tenant=~\"$tenant\",deployment_environment=~\"$env\"}[$__rate_interval]))",
          "refId": "B",
          "legendFormat": "chat turns",
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "axisLabel": "",
            "spanNulls": 300000,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMax": 1
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Error rate by service",
      "description": "Failures per request. MCP server-side failures and chat errors are what the alerts count (5% line). Server-side failures are server errors plus tool failures the server caused (error_code backend_unavailable or not_configured). MCP caller and deployment failures (a bad argument, a feature not turned on, an empty index) are shown but do not alert.",
      "datasource": {
        "type": "prometheus",
        "uid": "harborrag-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "harborrag-prometheus"
          },
          "expr": "(sum(rate(harborrag_mcp_tool_calls_total{tenant=~\"$tenant\",deployment_environment=~\"$env\",status=~\"error|tool_error\",error_code=~\"|backend_unavailable|not_configured\"}[$__rate_interval])) or vector(0)) / sum(rate(harborrag_mcp_tool_calls_total{tenant=~\"$tenant\",deployment_environment=~\"$env\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "MCP server-side failures",
          "exemplar": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "harborrag-prometheus"
          },
          "expr": "(sum(rate(harborrag_mcp_tool_calls_total{tenant=~\"$tenant\",deployment_environment=~\"$env\",status=\"tool_error\",error_code!~\"|backend_unavailable|not_configured\"}[$__rate_interval])) or vector(0)) / sum(rate(harborrag_mcp_tool_calls_total{tenant=~\"$tenant\",deployment_environment=~\"$env\"}[$__rate_interval]))",
          "refId": "C",
          "legendFormat": "MCP caller and deployment failures",
          "exemplar": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "harborrag-prometheus"
          },
          "expr": "(sum(rate(harborrag_chat_turns_total{tenant=~\"$tenant\",deployment_environment=~\"$env\",status=\"error\"}[$__rate_interval])) or vector(0)) / sum(rate(harborrag_chat_turns_total{tenant=~\"$tenant\",deployment_environment=~\"$env\"}[$__rate_interval]))",
          "refId": "B",
          "legendFormat": "chat errors",
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "axisLabel": "",
            "spanNulls": 300000,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "line"
            },
            "axisSoftMax": 0.1
          },
          "color": {
            "mode": "palette-classic"
          },
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
