      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "links": [
            {
              "title": "Stores and host",
              "url": "/d/harborrag-stores-host?${__url_time_range}&${__all_variables}"
            }
          ]
        },
        "overrides": []
