    {
      "type": "timeseries",
      "title": "Host memory and CPU",
      "description": "Host load from node_exporter. Shaded ingestion runs show whether a sync starves MCP on the shared host.",
      "datasource": {
        "type": "prometheus",
        "uid": "harborrag-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
