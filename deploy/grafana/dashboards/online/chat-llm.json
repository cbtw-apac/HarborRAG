      },
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Time to first token, p50 and p95",
      "description": "Per mode. An exemplar opens the turn's trace.",
      "datasource": {
        "type": "prometheus",
        "uid": "harborrag-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "harborrag-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, mode) (rate(harborrag_chat_ttft_seconds_bucket{mode=~\"$mode\",tenant=~\"$tenant\",deployment_environment=~\"$env\"}[$__rate_interval])))",
          "refId": "A",
          "legendFormat": "p95 {{mode}}",
          "exemplar": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "harborrag-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, mode) (rate(harborrag_chat_ttft_seconds_bucket{mode=~\"$mode\",tenant=~\"$tenant\",deployment_environment=~\"$env\"}[$__rate_interval])))",
          "refId": "B",
          "legendFormat": "p50 {{mode}}",
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "axisLabel": "",
            "spanNulls": 300000,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMax": 1
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 9,
      "gridPos": {
        "x": 8,
        "y": 6,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Citation results",
      "description": "Share of answers per citation result. A rising fail share: check retrieval.",
      "datasource": {
        "type": "prometheus",
        "uid": "harborrag-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "harborrag-prometheus"
          },
          "expr": "sum by (result) (increase(harborrag_chat_citation_checks_total[$__interval]))",
          "refId": "A",
          "legendFormat": "{{result}}",
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "axisLabel": "",
            "spanNulls": 300000,
            "stacking": {
              "mode": "percent",
              "group": "A"
            },
            "axisSoftMax": 1
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
