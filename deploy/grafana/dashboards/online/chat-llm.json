    {
      "type": "row",
      "title": "Where is it coming from",
      "id": 11,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Tokens per day by service and model",
      "description": "Prompt and completion tokens per day, by service, operation and model. Input-heavy chat turns mean trimming the context; ingestion embeds every new or changed document.",
      "datasource": {
        "type": "prometheus",
        "uid": "harborrag-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "harborrag-prometheus"
          },
          "expr": "sum by (job, gen_ai_operation_name, gen_ai_response_model, token_type) (increase(harborrag_model_tokens_total{token_type!=\"total_tokens\"}[1d]))",
          "refId": "A",
          "legendFormat": "{{job}} {{gen_ai_operation_name}} {{gen_ai_response_model}} {{token_type}}",
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "axisLabel": "",
            "spanNulls": 300000,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMax": 1
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^harborrag-worker( .*)?$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#338ced"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^harborrag-api( .*)?$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#e76624"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^harborrag-mcp( .*)?$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#00a888"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 12,
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Cost per day by service and model",
      "description": "Model cost per day by service (ingestion worker, chat API, MCP search), operation and model. The line is the daily budget alert. Cost is what the LiteLLM proxy reports from its price list: an estimate, not the invoice. Self-hosted models report 0. There is no tenant label, so cost cannot be split per tenant.",
      "datasource": {
        "type": "prometheus",
        "uid": "harborrag-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "harborrag-prometheus"
          },
          "expr": "sum by (job, gen_ai_operation_name, gen_ai_response_model) (increase(harborrag_model_cost_usd_total[1d]))",
          "refId": "A",
          "legendFormat": "{{job}} {{gen_ai_operation_name}} {{gen_ai_response_model}}",
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "axisLabel": "",
            "spanNulls": 300000,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "line"
            },
            "axisSoftMax": 0.01
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          },
          "min": 0,
          "noValue": "No model cost reported",
          "decimals": 4
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^harborrag-worker( .*)?$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#338ced"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^harborrag-api( .*)?$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#e76624"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^harborrag-mcp( .*)?$"
            },
            "properties": [
              {
                "id": "color",
