    {
      "id": 18,
      "type": "timeseries",
      "title": "Model call duration (p50 / p95)",
      "description": "histogram_quantile(q, sum(rate(harborrag_model_call_duration_seconds_bucket[5m])) by (le, provider, model)) -- covers embedding calls today (encode stage); chat calls once a chat-path caller passes a registry to build_model_telemetry too",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
