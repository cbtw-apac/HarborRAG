{
  "id": null,
  "uid": "harborrag-ingestion-timing",
  "title": "HarborRAG Ingestion Pipeline Timing",
  "description": "Per-stage timing for the document ingestion pipeline (fetch -> parse -> chunk -> encode/embed -> build relations/projections -> write to Qdrant/FalkorDB -> verify -> publish), from the harborrag_ingestion_stage_duration_seconds histogram (stage label, see observability_types.IngestionStage). There is no single end-to-end per-document metric; the 'approx total pipeline time' stat sums stage time and divides by documents parsed as an estimate, not a per-document trace.",
  "tags": ["harborrag", "ingestion"],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Pipeline stage timing",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "bargauge",
      "title": "Average stage duration",
      "description": "sum by (stage) (rate(harborrag_ingestion_stage_duration_seconds_sum[5m])) / sum by (stage) (rate(harborrag_ingestion_stage_duration_seconds_count[5m])), limited to the core per-document pipeline stages",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "x": 0, "y": 1, "w": 12, "h": 9 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "sum by (stage) (rate(harborrag_ingestion_stage_duration_seconds_sum{stage=~\"fetch|parse_normalize|chunk|encode|relation_build|projection_build|qdrant_write|falkordb_write|verification|publication\"}[5m])) / sum by (stage) (rate(harborrag_ingestion_stage_duration_seconds_count{stage=~\"fetch|parse_normalize|chunk|encode|relation_build|projection_build|qdrant_write|falkordb_write|verification|publication\"}[5m]))",
          "legendFormat": "{{stage}}",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "p95 stage duration",
      "description": "histogram_quantile(0.95, sum by (le, stage) (rate(harborrag_ingestion_stage_duration_seconds_bucket[5m]))), limited to the core per-document pipeline stages",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "x": 12, "y": 1, "w": 12, "h": 9 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(harborrag_ingestion_stage_duration_seconds_bucket{stage=~\"fetch|parse_normalize|chunk|encode|relation_build|projection_build|qdrant_write|falkordb_write|verification|publication\"}[5m])))",
          "legendFormat": "{{stage}}",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Parse duration (parse_normalize)",
      "description": "Document parsing/extraction, runs in an isolated subprocess. p50/p95/p99 from harborrag_ingestion_stage_duration_seconds_bucket{stage=\"parse_normalize\"}",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "x": 0, "y": 10, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }, "expr": "histogram_quantile(0.50, sum(rate(harborrag_ingestion_stage_duration_seconds_bucket{stage=\"parse_normalize\"}[5m])) by (le))", "legendFormat": "p50" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }, "expr": "histogram_quantile(0.95, sum(rate(harborrag_ingestion_stage_duration_seconds_bucket{stage=\"parse_normalize\"}[5m])) by (le))", "legendFormat": "p95" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }, "expr": "histogram_quantile(0.99, sum(rate(harborrag_ingestion_stage_duration_seconds_bucket{stage=\"parse_normalize\"}[5m])) by (le))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Embedding duration (encode)",
      "description": "Chunk embedding generation only (no vector-store write). p50/p95/p99 from harborrag_ingestion_stage_duration_seconds_bucket{stage=\"encode\"}",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "x": 12, "y": 10, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }, "expr": "histogram_quantile(0.50, sum(rate(harborrag_ingestion_stage_duration_seconds_bucket{stage=\"encode\"}[5m])) by (le))", "legendFormat": "p50" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }, "expr": "histogram_quantile(0.95, sum(rate(harborrag_ingestion_stage_duration_seconds_bucket{stage=\"encode\"}[5m])) by (le))", "legendFormat": "p95" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }, "expr": "histogram_quantile(0.99, sum(rate(harborrag_ingestion_stage_duration_seconds_bucket{stage=\"encode\"}[5m])) by (le))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Vector DB write duration (Qdrant)",
      "description": "p50/p95/p99 from harborrag_ingestion_stage_duration_seconds_bucket{stage=\"qdrant_write\"}",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "x": 0, "y": 18, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }, "expr": "histogram_quantile(0.50, sum(rate(harborrag_ingestion_stage_duration_seconds_bucket{stage=\"qdrant_write\"}[5m])) by (le))", "legendFormat": "p50" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }, "expr": "histogram_quantile(0.95, sum(rate(harborrag_ingestion_stage_duration_seconds_bucket{stage=\"qdrant_write\"}[5m])) by (le))", "legendFormat": "p95" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }, "expr": "histogram_quantile(0.99, sum(rate(harborrag_ingestion_stage_duration_seconds_bucket{stage=\"qdrant_write\"}[5m])) by (le))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Graph DB write duration (FalkorDB)",
      "description": "p50/p95/p99 from harborrag_ingestion_stage_duration_seconds_bucket{stage=\"falkordb_write\"}",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "x": 12, "y": 18, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }, "expr": "histogram_quantile(0.50, sum(rate(harborrag_ingestion_stage_duration_seconds_bucket{stage=\"falkordb_write\"}[5m])) by (le))", "legendFormat": "p50" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }, "expr": "histogram_quantile(0.95, sum(rate(harborrag_ingestion_stage_duration_seconds_bucket{stage=\"falkordb_write\"}[5m])) by (le))", "legendFormat": "p95" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }, "expr": "histogram_quantile(0.99, sum(rate(harborrag_ingestion_stage_duration_seconds_bucket{stage=\"falkordb_write\"}[5m])) by (le))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "All pipeline stages, p95 duration",
      "description": "One line per stage for fetch, parse_normalize, chunk, encode, relation_build, projection_build, qdrant_write, falkordb_write, verification, publication -- for comparing relative cost over time.",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "x": 0, "y": 26, "w": 24, "h": 9 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "histogram_quantile(0.95, sum(rate(harborrag_ingestion_stage_duration_seconds_bucket{stage=~\"fetch|parse_normalize|chunk|encode|relation_build|projection_build|qdrant_write|falkordb_write|verification|publication\"}[5m])) by (le, stage))",
          "legendFormat": "{{stage}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "row",
      "title": "Throughput & outcomes",
      "gridPos": { "x": 0, "y": 35, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Stage operations rate by outcome",
      "description": "sum(rate(harborrag_ingestion_stage_operations_total[5m])) by (stage, outcome), core pipeline stages only",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "x": 0, "y": 36, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "sum(rate(harborrag_ingestion_stage_operations_total{stage=~\"fetch|parse_normalize|chunk|encode|relation_build|projection_build|qdrant_write|falkordb_write|verification|publication\"}[5m])) by (stage, outcome)",
          "legendFormat": "{{stage}} {{outcome}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "table",
      "title": "Stage operation counts (current)",
      "description": "sum(harborrag_ingestion_stage_operations_total) by (stage, outcome)",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "x": 12, "y": 36, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "showHeader": true },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "sum(harborrag_ingestion_stage_operations_total) by (stage, outcome)",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Approx. total pipeline time per document",
      "description": "Estimate only, not a per-document trace: sum of core-stage time-rate divided by the rate of documents completing parse_normalize. sum(rate(harborrag_ingestion_stage_duration_seconds_sum{core stages}[5m])) / sum(rate(harborrag_ingestion_stage_operations_total{stage=\"parse_normalize\",outcome=\"success\"}[5m]))",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "x": 0, "y": 44, "w": 8, "h": 6 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "sum(rate(harborrag_ingestion_stage_duration_seconds_sum{stage=~\"fetch|parse_normalize|chunk|encode|relation_build|projection_build|qdrant_write|falkordb_write|verification|publication\"}[5m])) / sum(rate(harborrag_ingestion_stage_operations_total{stage=\"parse_normalize\",outcome=\"success\"}[5m]))",
          "instant": true
        }
      ]
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Documents parsed rate",
      "description": "sum(rate(harborrag_ingestion_stage_operations_total{stage=\"parse_normalize\"}[5m])) by (outcome)",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "x": 8, "y": 44, "w": 8, "h": 6 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "sum(rate(harborrag_ingestion_stage_operations_total{stage=\"parse_normalize\"}[5m])) by (outcome)",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Chunks produced rate",
      "description": "sum(rate(harborrag_ingestion_chunks_total[5m])) by (kind)",
