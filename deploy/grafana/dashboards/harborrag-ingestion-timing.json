      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "sum(rate(harborrag_ingestion_parser_engine_attempts_total[5m])) by (engine, outcome)",
