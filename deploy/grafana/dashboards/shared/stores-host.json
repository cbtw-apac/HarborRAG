{
  "uid": "harborrag-stores-host",
  "title": "Stores and host",
  "tags": [
    "harborrag",
    "shared",
    "stores"
  ],
  "editable": true,
  "schemaVersion": 41,
  "version": 1,
  "graphTooltip": 1,
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "harborrag-prometheus"
        },
        "query": {
          "query": "label_values(target_info, deployment_environment)",
          "refId": "env-values"
        },
        "definition": "label_values(target_info, deployment_environment)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "tenant",
        "label": "Tenant",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "harborrag-prometheus"
        },
        "query": {
          "query": "label_values(harborrag_mcp_tool_calls_total, tenant)",
          "refId": "tenant-values"
        },
        "definition": "label_values(harborrag_mcp_tool_calls_total, tenant)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Deploys",
        "enable": true,
        "iconColor": "blue",
        "datasource": {
          "type": "prometheus",
          "uid": "harborrag-prometheus"
        },
        "expr": "count by (job, service_version) (target_info) unless count by (job, service_version) (last_over_time(target_info[1d] offset 5m))",
        "step": "1m",
        "titleFormat": "Deploy {{job}}",
        "textFormat": "version {{service_version}}"
      },
      {
        "name": "Alerts firing",
        "enable": true,
        "iconColor": "red",
        "datasource": {
          "type": "prometheus",
          "uid": "harborrag-prometheus"
        },
        "expr": "ALERTS{alertstate=\"firing\"}",
        "step": "1m",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{severity}} {{side}}"
      },
      {
        "name": "Ingestion runs",
        "enable": true,
        "iconColor": "purple",
        "datasource": {
          "type": "prometheus",
          "uid": "harborrag-prometheus"
        },
        "expr": "max by (tenant, source_scope_id) (harborrag_ingestion_source_last_run_status{status=\"running\"}) == 1",
        "step": "1m",
        "titleFormat": "Ingestion run",
        "textFormat": "{{tenant}} {{source_scope_id}}"
      }
    ]
  },
  "links": [
    {
      "title": "HarborRAG",
      "type": "dashboards",
      "tags": [
        "harborrag"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Runbooks",
      "type": "link",
      "icon": "doc",
      "targetBlank": true,
      "url": "https://github.com/cbtw-apac/HarborRAG/blob/main/docs/developers/deployment/observability-runbooks.md",
      "tooltip": "What each alert means and how to respond"
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Is it healthy now",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Host memory",
      "description": "Used host memory. Red at 90%, the host resources alert.",
      "datasource": {
        "type": "prometheus",
        "uid": "harborrag-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "harborrag-prometheus"
          },
          "expr": "1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes",
          "refId": "A",
          "legendFormat": "__auto",
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Host disk",
      "description": "Used space on the fullest real filesystem. Red at 85%, the host resources alert.",
      "datasource": {
        "type": "prometheus",
        "uid": "harborrag-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "harborrag-prometheus"
          },
          "expr": "max(1 - node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs|9p|drvfs\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|squashfs|9p|drvfs\"})",
          "refId": "A",
          "legendFormat": "__auto",
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.75
              },
              {
                "color": "red",
                "value": 0.85
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": 3,
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Slowest store p95",
      "description": "p95 of the slowest store-facing span over 5 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "harborrag-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "harborrag-prometheus"
          },
          "expr": "max(histogram_quantile(0.95, sum by (le, span_name) (rate(traces_span_metrics_duration_seconds_bucket{deployment_environment=~\"$env\",span_name=~\"retrieval[.].*|harborrag[.]ingestion[.](qdrant_write|falkordb_write|canonical_persist|fetch)\"}[5m]))))",
          "refId": "A",
          "legendFormat": "__auto",
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": 4,
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Store error rate",
      "description": "Share of store-facing spans that ended in error over 5 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "harborrag-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "harborrag-prometheus"
          },
          "expr": "(sum(rate(traces_span_metrics_calls_total{deployment_environment=~\"$env\",span_name=~\"retrieval[.].*|harborrag[.]ingestion[.](qdrant_write|falkordb_write|canonical_persist|fetch)\",status_code=\"STATUS_CODE_ERROR\"}[5m])) or vector(0)) / sum(rate(traces_span_metrics_calls_total{deployment_environment=~\"$env\",span_name=~\"retrieval[.].*|harborrag[.]ingestion[.](qdrant_write|falkordb_write|canonical_persist|fetch)\"}[5m]))",
          "refId": "A",
          "legendFormat": "__auto",
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": 5,
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
