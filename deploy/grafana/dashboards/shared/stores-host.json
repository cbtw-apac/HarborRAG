    {
      "type": "bargauge",
      "title": "Memory per container",
      "description": "Working-set memory per container, largest first: who crowds the host. Where cAdvisor cannot read container names, as on Docker Desktop, rows show the short container ID that docker ps prints.",
      "datasource": {
        "type": "prometheus",
        "uid": "harborrag-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "harborrag-prometheus"
          },
          "expr": "sort_desc(sum by (name) (container_memory_working_set_bytes{name!=\"\"}) or sum by (name) (label_replace(container_memory_working_set_bytes{id=~\"/docker/[0-9a-f]{64}|/system[.]slice/docker-[0-9a-f]{64}[.]scope\"}, \"name\", \"$1\", \"id\", \".*docker[-/]([0-9a-f]{12}).*\")))",
          "refId": "A",
          "legendFormat": "{{name}}",
          "exemplar": false,
