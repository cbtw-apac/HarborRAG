    {
      "type": "timeseries",
      "title": "Retrieval step p95",
      "description": "p95 of each retrieval step from HarborRAG's own spans: embedding, the Qdrant query, graph expansion, evidence loading. Exemplars open traces.",
      "datasource": {
        "type": "prometheus",
        "uid": "harborrag-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "harborrag-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, span_name) (rate(traces_span_metrics_duration_seconds_bucket{deployment_environment=~\"$env\",span_name=~\"retrieval[.].*\"}[$__rate_interval])))",
          "refId": "A",
          "legendFormat": "{{span_name}}",
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "axisLabel": "",
            "spanNulls": 300000,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMax": 1
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "noValue": "No retrieval in range"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "retrieval.dense.embed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#338ced"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "retrieval.sparse.encode"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#e76624"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "retrieval.vector.query"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#00a888"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "retrieval.graph.expand"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d28e05"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "retrieval.evidence.load"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#e24d8b"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "retrieval.assembly"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#0aac23"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 8,
        "h": 8
      }
    },
