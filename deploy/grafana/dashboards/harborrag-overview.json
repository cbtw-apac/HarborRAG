      "type": "timeseries",
      "title": "Connector rate-limit events",
      "description": "sum(rate(harborrag_ingestion_connector_rate_limit_events_total[5m])) by (connector_type)",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "x": 16, "y": 34, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
