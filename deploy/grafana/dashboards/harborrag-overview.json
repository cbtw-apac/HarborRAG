          "expr": "sum(rate(harborrag_ingestion_stage_operations_total[5m])) by (stage, outcome)",
          "legendFormat": "{{stage}} {{outcome}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Ingestion stage duration p95",
      "description": "histogram_quantile(0.95, sum(rate(harborrag_ingestion_stage_duration_seconds_bucket[5m])) by (le, stage))",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "x": 12, "y": 18, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "histogram_quantile(0.95, sum(rate(harborrag_ingestion_stage_duration_seconds_bucket[5m])) by (le, stage))",
          "legendFormat": "p95 {{stage}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Documents ingested rate",
      "description": "sum(rate(harborrag_ingestion_documents_total[5m])) by (outcome, connector_type)",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
