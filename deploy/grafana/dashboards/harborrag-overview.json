    {
      "id": 14,
      "type": "timeseries",
      "title": "Chunks produced rate",
      "description": "sum(rate(harborrag_ingestion_chunks_total[5m])) by (kind)",
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "gridPos": { "x": 12, "y": 26, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "sum(rate(harborrag_ingestion_chunks_total[5m])) by (kind)",
          "legendFormat": "{{kind}}"
