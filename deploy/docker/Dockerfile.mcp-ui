# Optional HarborRAG Explorer MCP UI server (harborrag-mcp-ui).
#
# Built on the reader MCP image rather than beside it, so the workspace layout,
# locked dependencies, non-root user and audit directory stay defined once in
# Dockerfile.mcp. This layer only adds the locked `ui` extra (FastMCP Apps and
# Prefab) and switches the entrypoint; the reader image never contains it.
# scripts/deployment/mcp-ui.sh builds the base image first when it is missing.
ARG HARBORRAG_MCP_IMAGE=harborrag-mcp-mcp
FROM ${HARBORRAG_MCP_IMAGE}

USER root
WORKDIR /app
RUN uv export --quiet --frozen --package harborrag-mcp-server --extra reader --extra ui \
        --no-dev --no-hashes --no-emit-workspace \
        --output-file /tmp/harborrag-ui-lock.txt \
    && uv pip install --system \
        --constraint /tmp/harborrag-ui-lock.txt \
        -e 'packages/harborrag-mcp-server[reader,ui]' \
    && rm -f /tmp/harborrag-ui-lock.txt

WORKDIR /var/lib/harborrag
USER harborrag

STOPSIGNAL SIGTERM
ENTRYPOINT ["harborrag-mcp-ui"]
CMD ["--http"]
