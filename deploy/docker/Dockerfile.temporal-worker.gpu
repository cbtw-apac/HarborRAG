FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

# GPU variant of Dockerfile.temporal-worker. NOTE: as configured today this
# image has no GPU-accelerated consumer left. Docling (the only torch user)
# went away with the switch to LiteParse, and both PDF and image OCR now run
# on the external OCR server named by config/parsers.yaml, not in-process.
# Keep this only for a future in-worker GPU workload; the CPU image is the
# supported path. Requires an NVIDIA driver and the NVIDIA Container Toolkit
# on the host; pair with docker-compose.temporal.gpu.yml.

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_NO_CACHE=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libgl1 \
        libglib2.0-0 \
        libxcb1 \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml uv.lock ./
COPY packages/harborrag-core/pyproject.toml packages/harborrag-core/README.md ./packages/harborrag-core/
COPY packages/harborrag-core/src/harborrag_core/__init__.py ./packages/harborrag-core/src/harborrag_core/
COPY packages/harborrag-adapters/pyproject.toml packages/harborrag-adapters/README.md ./packages/harborrag-adapters/
COPY packages/harborrag-adapters/src/harborrag_adapters/__init__.py ./packages/harborrag-adapters/src/harborrag_adapters/
COPY packages/harborrag-memory/pyproject.toml packages/harborrag-memory/README.md ./packages/harborrag-memory/
COPY packages/harborrag-memory/src/harborrag_memory/__init__.py ./packages/harborrag-memory/src/harborrag_memory/
COPY packages/harborrag-engine/pyproject.toml packages/harborrag-engine/README.md ./packages/harborrag-engine/
COPY packages/harborrag-engine/src/harborrag_engine/__init__.py ./packages/harborrag-engine/src/harborrag_engine/
COPY packages/harborrag-runtime/pyproject.toml packages/harborrag-runtime/README.md ./packages/harborrag-runtime/
COPY packages/harborrag-runtime/src/harborrag_runtime/__init__.py ./packages/harborrag-runtime/src/harborrag_runtime/
COPY packages/harborrag-app/pyproject.toml packages/harborrag-app/README.md ./packages/harborrag-app/
COPY packages/harborrag-app/src/harborrag_app/__init__.py ./packages/harborrag-app/src/harborrag_app/
COPY packages/harborrag-mcp-server/pyproject.toml packages/harborrag-mcp-server/README.md ./packages/harborrag-mcp-server/
COPY packages/harborrag-mcp-server/src/harborrag_mcp_server/__init__.py ./packages/harborrag-mcp-server/src/harborrag_mcp_server/
COPY packages/harborrag/pyproject.toml packages/harborrag/README.md ./packages/harborrag/
COPY packages/harborrag/src/harborrag/__init__.py ./packages/harborrag/src/harborrag/

# CUDA wheels declare their own nvidia-*-cu12 runtime dependencies, hosted on
# PyPI rather than the PyTorch index, so --no-deps cannot be used here. torch
# also delivers the nvidia-*-cu12 CUDA runtime libraries that LD_LIBRARY_PATH
# below points at, which is why it stays here after the CPU image dropped it.
# The onnxruntime swap is now a no-op guard: no adapter extra installs
# onnxruntime any more, so it only matters if one is reintroduced.
RUN uv export --quiet --frozen --package harborrag-runtime \
        --extra production --extra temporal \
        --no-dev --no-hashes --no-emit-workspace \
        --output-file /tmp/harborrag-lock.txt \
    && uv pip install --system \
        --index-url https://download.pytorch.org/whl/cu126 \
        --extra-index-url https://pypi.org/simple \
        --constraint /tmp/harborrag-lock.txt \
        'torch==2.13.0' 'torchvision==0.28.0' \
    && uv pip install --system --constraint /tmp/harborrag-lock.txt \
        -e packages/harborrag-core \
        -e 'packages/harborrag-adapters[chunking,control-plane,falkordb,langfuse,llm,opentelemetry,parsers,pdf-liteparse,postgres,qdrant,redis,s3,tables]' \
        -e packages/harborrag-memory \
        -e packages/harborrag-engine \
        -e 'packages/harborrag-runtime[temporal]' \
    && uv pip uninstall --system onnxruntime \
    && uv pip install --system 'onnxruntime-gpu>=1.20,<2' \
    && rm -f /tmp/harborrag-lock.txt \
    && groupadd --gid 10001 harborrag \
    && useradd --uid 10001 --gid harborrag --no-log-init \
        --home-dir /var/lib/harborrag --create-home \
        --shell /usr/sbin/nologin harborrag \
    && mkdir -p \
        /var/lib/harborrag/.cache/huggingface \
        /var/lib/harborrag/objects \
    && chown -R harborrag:harborrag /var/lib/harborrag

COPY packages/harborrag-core ./packages/harborrag-core
COPY packages/harborrag-adapters ./packages/harborrag-adapters
COPY packages/harborrag-memory ./packages/harborrag-memory
COPY packages/harborrag-engine ./packages/harborrag-engine
COPY packages/harborrag-runtime ./packages/harborrag-runtime
COPY config ./config

# The container runs from the writable data directory, not from /app, so the
# tracked YAML files need absolute paths. Override these to point at a mounted
# configuration directory instead.
ENV HARBORRAG_TEMPORAL_CONFIG_PATH=/app/config/temporal.yaml \
    HARBORRAG_CONNECTOR_CONFIG_PATH=/app/config/connectors.yaml \
    HARBORRAG_PARSER_CONFIG_PATH=/app/config/parsers.yaml \
    HARBORRAG_MODEL_CONFIG_PATH=/app/config/models.yaml \
    HARBORRAG_GRAPH_BUILD_CONFIG_PATH=/app/config/topology/graph_build.yaml

# onnxruntime-gpu's CUDAExecutionProvider loads libcudart/libcublas/libcudnn at
# runtime; point it at the copies pip-installed alongside torch's cu121 build
# instead of requiring a system CUDA toolkit.
ENV LD_LIBRARY_PATH=/usr/local/lib/python3.12/site-packages/nvidia/cuda_runtime/lib:/usr/local/lib/python3.12/site-packages/nvidia/cublas/lib:/usr/local/lib/python3.12/site-packages/nvidia/cudnn/lib:/usr/local/lib/python3.12/site-packages/nvidia/cufft/lib:/usr/local/lib/python3.12/site-packages/nvidia/curand/lib

WORKDIR /var/lib/harborrag
USER harborrag

CMD ["python", "-m", "harborrag_runtime.temporal.worker"]
