[importlinter:contract:16]
name = Only composition and config deep-import adapters
type = forbidden
allow_indirect_imports = true
unmatched_ignore_imports_alerting = error
source_modules =
    harborrag_runtime.agent
    harborrag_runtime.chat
    harborrag_runtime.contracts
    harborrag_runtime.document_stage_catalog
    harborrag_runtime.errors
    harborrag_runtime.events
    harborrag_runtime.execution
    harborrag_runtime.ingestion
    harborrag_runtime.ingestion_contracts
    harborrag_runtime.memory
    harborrag_runtime.observability
    harborrag_runtime.plugins
    harborrag_runtime.rate_limiting
    harborrag_runtime.reader_contracts
    harborrag_runtime.retrieval
    harborrag_runtime.sdk
    harborrag_runtime.serialization
    harborrag_runtime.source_query
    harborrag_runtime.temporal
    harborrag_runtime.temporal_models
    harborrag_runtime.tokenization
    harborrag_runtime.topology
forbidden_modules =
    harborrag_adapters.models.chat.configs
    harborrag_adapters.models.chat.langchain
    harborrag_adapters.models.embed.configs
    harborrag_adapters.parsers.common.base
    harborrag_adapters.parsers.*.engines
    harborrag_adapters.parsers.*.parser
    harborrag_adapters.parsers.pdf.base
    harborrag_adapters.parsers.pdf.config
    harborrag_adapters.repositories.backends.sqlalchemy
    harborrag_adapters.repositories.database.control_plane
    harborrag_adapters.repositories.graph.falkordb
    harborrag_adapters.repositories.object_store.filesystem
    harborrag_adapters.repositories.object_store.memory
    harborrag_adapters.repositories.object_store.s3
    harborrag_adapters.repositories.vector.qdrant
ignore_imports =
    harborrag_runtime.agent.checkpoint -> harborrag_adapters.repositories.database.control_plane.agent_runs
    harborrag_runtime.agent.checkpoint -> harborrag_adapters.repositories.database.control_plane.engine
    harborrag_runtime.agent.checkpoint -> harborrag_adapters.repositories.database.control_plane.migrations
    harborrag_runtime.memory.composition -> harborrag_adapters.repositories.database.control_plane.conversation
    harborrag_runtime.memory.composition -> harborrag_adapters.repositories.database.control_plane.engine
    harborrag_runtime.memory.composition -> harborrag_adapters.repositories.database.control_plane.migrations
    harborrag_runtime.memory.model -> harborrag_adapters.models.chat.langchain
