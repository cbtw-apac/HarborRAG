[importlinter]
root_packages =
    harborrag
    harborrag_core
    harborrag_adapters
    harborrag_engine
    harborrag_runtime
    harborrag_app
    harborrag_mcp

[importlinter:contract:1]
name = Core has no outward dependencies
type = forbidden
source_modules =
    harborrag_core
forbidden_modules =
    harborrag
    harborrag_adapters
    harborrag_engine
    harborrag_app
    harborrag_mcp
    harborrag_runtime

[importlinter:contract:2]
name = Adapters never depend on engine or transports
type = forbidden
source_modules =
    harborrag_adapters
forbidden_modules =
    harborrag
    harborrag_engine
    harborrag_app
    harborrag_mcp
    harborrag_runtime

[importlinter:contract:3]
name = Engine never depends on transports
type = forbidden
source_modules =
    harborrag_engine
forbidden_modules =
    harborrag
    harborrag_app
    harborrag_mcp
    harborrag_runtime
