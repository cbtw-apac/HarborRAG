[importlinter]
root_packages =
    harborrag
    harborrag_core
    harborrag_adapters
    harborrag_engine
    harborrag_memory
    harborrag_runtime
    harborrag_app
    harborrag_mcp_server

[importlinter:contract:1]
name = Core has no outward dependencies
type = forbidden
source_modules =
    harborrag_core
forbidden_modules =
    harborrag
    harborrag_adapters
    harborrag_engine
    harborrag_memory
    harborrag_app
    harborrag_mcp_server
    harborrag_runtime

[importlinter:contract:2]
name = Adapters never depend on engine or transports
type = forbidden
source_modules =
    harborrag_adapters
forbidden_modules =
    harborrag
    harborrag_engine
    harborrag_memory
    harborrag_app
    harborrag_mcp_server
    harborrag_runtime

[importlinter:contract:3]
name = Engine depends only on core
type = forbidden
source_modules =
    harborrag_engine
forbidden_modules =
    harborrag
    harborrag_adapters
    harborrag_memory
    harborrag_app
    harborrag_mcp_server
    harborrag_runtime

[importlinter:contract:4]
name = Runtime never depends on transports
type = forbidden
source_modules =
    harborrag_runtime
forbidden_modules =
    harborrag
    harborrag_app
    harborrag_mcp_server

[importlinter:contract:5]
name = App never depends on adapters or MCP
type = forbidden
allow_indirect_imports = true
source_modules =
    harborrag_app
forbidden_modules =
    harborrag
    harborrag_adapters
    harborrag_mcp_server

[importlinter:contract:6]
name = MCP never depends on adapters or app
type = forbidden
allow_indirect_imports = true
source_modules =
    harborrag_mcp_server
forbidden_modules =
    harborrag
    harborrag_adapters
    harborrag_app

[importlinter:contract:7]
name = Memory depends only on core
type = forbidden
source_modules =
    harborrag_memory
forbidden_modules =
    harborrag
    harborrag_adapters
    harborrag_engine
    harborrag_app
    harborrag_mcp_server
    harborrag_runtime

[importlinter:contract:8]
name = Runtime config does not depend on runtime services
type = forbidden
source_modules =
    harborrag_runtime.config
forbidden_modules =
    harborrag_runtime.chat
    harborrag_runtime.ingestion
    harborrag_runtime.memory
    harborrag_runtime.retrieval
    harborrag_runtime.sdk
    harborrag_runtime.temporal

[importlinter:contract:9]
name = Ingestion domain does not depend on orchestration or serving
type = forbidden
source_modules =
    harborrag_runtime.ingestion.document
    harborrag_runtime.ingestion.maintenance
    harborrag_runtime.ingestion.source
forbidden_modules =
    harborrag_runtime.chat
    harborrag_runtime.retrieval
    harborrag_runtime.sdk
    harborrag_runtime.temporal

[importlinter:contract:10]
name = Retrieval does not depend on orchestration or serving
type = forbidden
source_modules =
    harborrag_runtime.retrieval
forbidden_modules =
    harborrag_runtime.chat
    harborrag_runtime.sdk
    harborrag_runtime.temporal

[importlinter:contract:11]
name = App consumes the ingestion gateway rather than Temporal internals
type = forbidden
allow_indirect_imports = true
source_modules =
    harborrag_app
forbidden_modules =
    harborrag_runtime.temporal

[importlinter:contract:13]
name = MCP does not import optional runtime layers
type = forbidden
source_modules =
    harborrag_mcp_server
forbidden_modules =
    harborrag_memory
    harborrag_runtime.chat
    harborrag_runtime.memory
    harborrag_runtime.sdk

[importlinter:contract:14]
name = Reader composition does not import optional runtime layers
type = forbidden
source_modules =
    harborrag_runtime.composition.readers
forbidden_modules =
    harborrag_runtime.chat
    harborrag_runtime.memory
    harborrag_runtime.sdk
    harborrag_runtime.execution
    harborrag_runtime.config.temporal

[importlinter:contract:15]
name = Adapter families never import each other
type = independence
modules =
    harborrag_adapters.chunking
    harborrag_adapters.connectors
    harborrag_adapters.models
    harborrag_adapters.parsers
    harborrag_adapters.repositories
    harborrag_adapters.topology
# Known debt, each removed by its cleanup step; an entry that no longer matches fails CI.
ignore_imports =
    harborrag_adapters.parsers.markup.engines.markdown.engine -> harborrag_adapters.chunking.languages
    harborrag_adapters.parsers.text.engines.plain_text.engine -> harborrag_adapters.chunking.languages
    harborrag_adapters.repositories.database.control_plane.model_catalog_rows -> harborrag_adapters.models.chat.registry
    harborrag_adapters.topology.descriptions -> harborrag_adapters.models.chat.configs
    harborrag_adapters.topology.descriptions -> harborrag_adapters.models.chat.structured
    harborrag_adapters.topology.descriptions -> harborrag_adapters.models.runtime.provider
    harborrag_adapters.topology.extractor -> harborrag_adapters.models.chat
    harborrag_adapters.topology.extractor -> harborrag_adapters.models.chat.backend_config
    harborrag_adapters.topology.extractor -> harborrag_adapters.models.chat.structured
    harborrag_adapters.topology.artifacts -> harborrag_adapters.repositories.object_store.ingestion_artifacts
unmatched_ignore_imports_alerting = error

[importlinter:contract:16]
name = Shared adapter helpers import no adapter family
type = forbidden
source_modules =
    harborrag_adapters._shared
forbidden_modules =
    harborrag_adapters.chunking
    harborrag_adapters.connectors
    harborrag_adapters.models
    harborrag_adapters.parsers
    harborrag_adapters.repositories
    harborrag_adapters.topology
