[importlinter]
root_packages =
    harborrag
    harborrag_core
    harborrag_adapters
    harborrag_engine
    harborrag_memory
    harborrag_runtime
    harborrag_app
    harborrag_mcp_server

[importlinter:contract:1]
name = Core has no outward dependencies
type = forbidden
source_modules =
    harborrag_core
forbidden_modules =
    harborrag
    harborrag_adapters
    harborrag_engine
    harborrag_memory
    harborrag_app
    harborrag_mcp_server
    harborrag_runtime

[importlinter:contract:2]
name = Adapters never depend on engine or transports
type = forbidden
source_modules =
    harborrag_adapters
forbidden_modules =
    harborrag
    harborrag_engine
    harborrag_memory
    harborrag_app
    harborrag_mcp_server
    harborrag_runtime

[importlinter:contract:3]
name = Engine depends only on core
type = forbidden
source_modules =
    harborrag_engine
forbidden_modules =
    harborrag
    harborrag_adapters
    harborrag_memory
    harborrag_app
    harborrag_mcp_server
    harborrag_runtime

[importlinter:contract:4]
name = Runtime never depends on transports
type = forbidden
source_modules =
    harborrag_runtime
forbidden_modules =
    harborrag
    harborrag_app
    harborrag_mcp_server

[importlinter:contract:5]
name = App never depends on adapters or MCP
type = forbidden
allow_indirect_imports = true
source_modules =
    harborrag_app
forbidden_modules =
    harborrag
    harborrag_adapters
    harborrag_mcp_server

[importlinter:contract:6]
name = MCP never depends on adapters or app
type = forbidden
allow_indirect_imports = true
source_modules =
    harborrag_mcp_server
forbidden_modules =
    harborrag
    harborrag_adapters
    harborrag_app

[importlinter:contract:7]
name = Memory depends only on core
type = forbidden
source_modules =
    harborrag_memory
forbidden_modules =
    harborrag
    harborrag_adapters
    harborrag_engine
    harborrag_app
    harborrag_mcp_server
    harborrag_runtime

[importlinter:contract:8]
name = Runtime config does not depend on runtime services
type = forbidden
source_modules =
    harborrag_runtime.config
forbidden_modules =
    harborrag_runtime.agent
    harborrag_runtime.chat
    harborrag_runtime.ingestion
    harborrag_runtime.memory
    harborrag_runtime.retrieval
    harborrag_runtime.sdk
    harborrag_runtime.temporal

[importlinter:contract:9]
name = Ingestion domain does not depend on orchestration or serving
type = forbidden
source_modules =
    harborrag_runtime.ingestion.document
    harborrag_runtime.ingestion.maintenance
    harborrag_runtime.ingestion.source
forbidden_modules =
    harborrag_runtime.agent
    harborrag_runtime.chat
    harborrag_runtime.retrieval
    harborrag_runtime.sdk
    harborrag_runtime.temporal

[importlinter:contract:10]
name = Retrieval does not depend on orchestration or serving
type = forbidden
source_modules =
    harborrag_runtime.retrieval
forbidden_modules =
    harborrag_runtime.agent
    harborrag_runtime.chat
    harborrag_runtime.sdk
    harborrag_runtime.temporal

[importlinter:contract:11]
name = App consumes the ingestion gateway rather than Temporal internals
type = forbidden
allow_indirect_imports = true
source_modules =
    harborrag_app
forbidden_modules =
    harborrag_runtime.temporal

[importlinter:contract:12]
name = Shared reader tools do not depend on agent orchestration
type = forbidden
source_modules =
    harborrag_engine.tools
forbidden_modules =
    harborrag_engine.agent

[importlinter:contract:13]
name = MCP does not import optional runtime layers
type = forbidden
source_modules =
    harborrag_mcp_server
forbidden_modules =
    harborrag_memory
    harborrag_runtime.agent
    harborrag_runtime.chat
    harborrag_runtime.memory
    harborrag_runtime.sdk

[importlinter:contract:14]
name = Reader composition does not import optional runtime layers
type = forbidden
source_modules =
    harborrag_runtime.composition.readers
forbidden_modules =
    harborrag_runtime.agent
    harborrag_runtime.chat
    harborrag_runtime.memory
    harborrag_runtime.sdk
    harborrag_runtime.execution
    harborrag_runtime.config.temporal

# Ratchet contracts (15, 16). The ignore_imports lists freeze today's known
# violations: delete an entry when you remove the import it covers. Never add
# entries. unmatched_ignore_imports_alerting = error makes lint-imports fail
# when an entry no longer matches any import, so the lists can only shrink.

[importlinter:contract:15]
name = Runtime application services do not depend on adapters
type = forbidden
allow_indirect_imports = true
unmatched_ignore_imports_alerting = error
source_modules =
