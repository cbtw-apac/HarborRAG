# The enabled pdf-default/fast profile requires no credentials.
# Uncomment only the variables required by the alternative parser block that
# you enable in config/parsers.yaml.

# LiteParse encrypted-PDF support.
# PDF_DOCUMENT_PASSWORD=

# MinerU remote VLM endpoint. The endpoint must serve a MinerU-compatible model
# through an OpenAI-compatible API; a generic OpenAI model is not assumed to be
# compatible with MinerU's document extraction protocol.
# OPENAI_API_KEY=
# OPENAI_VLM_MODEL=opendatalab/MinerU2.5-2509-1.2B
# MINERU_API_MAX_CONCURRENT_REQUESTS=4

# Optional model/cache controls consumed by parser dependencies.
# HF_HOME=./.cache/huggingface
# PADDLE_PDX_MODEL_SOURCE=HuggingFace

# Optional Tesseract language-data directory for OCR integrations.
# Windows example: C:/Program Files/Tesseract-OCR/tessdata
# TESSDATA_PREFIX=
