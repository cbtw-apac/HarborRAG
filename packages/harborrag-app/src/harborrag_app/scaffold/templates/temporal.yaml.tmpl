# Temporal settings, used only by the durable commands (`harborrag ingest start|status|...`).
# `harborrag ingest run` ignores this file. See docs/users/configuration for the full reference.
version: 1

connection:
  target: localhost:7233
  namespace: harborrag
  identity: harborrag-runtime
  allow_insecure_remote: false
  tls:
    enabled: false
    domain: null

worker:
  identity: harborrag-runtime
  max_concurrent_activities: 2
  max_concurrent_workflow_tasks: 4
  max_concurrent_activity_polls: 2
  max_concurrent_workflow_polls: 2
  graceful_shutdown_seconds: 30

task_queues:
  discovery: harborrag-discovery
  transform: harborrag-transform
  io: harborrag-io
  parser: harborrag-parser
  model: harborrag-model
  index: harborrag-index

retries:
  discovery:
    initial_interval_seconds: 2
    backoff_coefficient: 2
    maximum_interval_seconds: 60
    maximum_attempts: 8
  document:
    initial_interval_seconds: 2
    backoff_coefficient: 2
    maximum_interval_seconds: 120
    maximum_attempts: 5

ingestion:
  batch_size: 200
  document_concurrency: 8

workflow:
  execution_timeout_seconds: 2592000
  task_timeout_seconds: 10

health:
  timeout_seconds: 5
