# HarborRAG project. Generated by `harborrag init` on @{created_at}.
#
# The CLI finds this file by walking up from the current directory (or use --project /
# HARBORRAG_PROJECT). The SDK reads it with HarborRAG.from_config("harborrag.yaml").
# Values under `runtime:` seed HARBORRAG_* settings; anything in .env or the shell wins.
execution_mode: direct
discover_plugins: false

runtime:
  env: dev
  connector_config_path: config/connectors.yaml
  parser_config_path: config/parsers.yaml
  model_config_path: config/models.yaml
  temporal_config_path: config/temporal.yaml
